+func TestAccessFallbackRealExecutorThenNormalSelection(t *testing.T) {
+	var calls atomic.Int32
+	upstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		calls.Add(1)
+		if r.URL.Path != "/responses" || r.Header.Get("Authorization") != "Bearer fixture-access" {
+			t.Errorf("unexpected request %s", r.URL.Path)
+			w.WriteHeader(400)
+			return
+		}
+		w.Header().Set("Content-Type", "text/event-stream")
+		_, _ = w.Write([]byte("event: response.created\ndata: {\"type\":\"response.created\",\"response\":{\"status\":\"in_progress\"}}\n\n"))
+		_, _ = w.Write([]byte("event: response.output_text.delta\ndata: {\"type\":\"response.output_text.delta\",\"delta\":\"OK\"}\n\n"))
+		_, _ = w.Write([]byte("data: {\"type\":\"response.completed\",\"response\":{\"id\":\"fixture-response\",\"object\":\"response\",\"status\":\"completed\",\"model\":\"gpt-6-astra\",\"output\":[{\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"output_text\",\"text\":\"OK\"}]}]}}\n\n"))
+	}))
+	defer upstream.Close()
+	cfg := &config.Config{}
+	manager := auth.NewManager(nil, nil, nil)
+	manager.SetConfig(cfg)
+	manager.SetCooldownStateStore(auth.NewFileCooldownStateStore(t.TempDir()))
+	executor := &fallbackRealExecutor{ProviderExecutor: runtime.NewCodexAutoExecutor(cfg)}
+	manager.RegisterExecutor(executor)
+	directory := t.TempDir()
+	metadata, err := json.Marshal(map[string]any{"type": "codex", "access_token": "fixture-access", "refresh_token": "fixture-refresh", "expired": time.Now().Add(time.Hour).Format(time.RFC3339), "codex_allow_valid_access_after_refresh_failure": true})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(directory, "fallback.json"), metadata, 0600); err != nil {
+		t.Fatal(err)
+	}
+	entries, err := synthesizer.NewFileSynthesizer().Synthesize(&synthesizer.SynthesisContext{Config: cfg, AuthDir: directory, Now: time.Now(), IDGenerator: synthesizer.NewStableIDGenerator()})
+	if err != nil || len(entries) != 1 {
+		t.Fatalf("file synthesis: count=%d err=%v", len(entries), err)
+	}
+	entry := entries[0]
+	entry.Attributes["base_url"] = upstream.URL
+	if entry.FileName != "" {
+		t.Fatal("file loader unexpectedly populated FileName")
+	}
+	if _, err := manager.Register(context.Background(), entry); err != nil {
+		t.Fatal(err)
+	}
+	registry.GetGlobalRegistry().RegisterClient(entry.ID, "codex", []*registry.ModelInfo{{ID: "gpt-6-astra", Object: "model", OwnedBy: "openai"}})
+	defer registry.GetGlobalRegistry().UnregisterClient(entry.ID)
+	_, _ = manager.RefreshAuth(context.Background(), entry.ID)
+	fp := fmt.Sprintf("%x", sha256.Sum256([]byte("fixture-access")))
+	handler := &Handler{cfg: cfg, authManager: manager}
+	listed := handler.buildAuthFileEntry(entry)
+	requestBody, err := json.Marshal(map[string]any{"name": listed["name"], "auth_index": listed["auth_index"], "model": "gpt-6-astra", "token_fingerprint": fp})
+	if err != nil {
+		t.Fatal(err)
+	}
+	router := gin.New()
+	router.POST("/verify", handler.VerifyAccessTokenFallback)
+	staleBody, err := json.Marshal(map[string]any{"name": listed["name"], "auth_index": listed["auth_index"], "model": "gpt-6-astra", "token_fingerprint": fmt.Sprintf("%064d", 0)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	staleResponse := httptest.NewRecorder()
+	staleRequest := httptest.NewRequest(http.MethodPost, "/verify", bytes.NewReader(staleBody))
+	staleRequest.Header.Set("Content-Type", "application/json")
+	router.ServeHTTP(staleResponse, staleRequest)
+	var stale auth.QuotaVerification
+	if err := json.Unmarshal(staleResponse.Body.Bytes(), &stale); err != nil || staleResponse.Code != 200 || stale.Passed || stale.Restored || stale.Reason != "credential_changed" || calls.Load() != 0 {
+		t.Fatalf("unexpected stale fingerprint response or upstream invocation: %s", staleResponse.Body.String())
+	}
+	response := httptest.NewRecorder()
+	request := httptest.NewRequest(http.MethodPost, "/verify", bytes.NewReader(requestBody))
+	request.Header.Set("Content-Type", "application/json")
+	router.ServeHTTP(response, request)
+	if response.Code != http.StatusOK {
+		t.Fatalf("advertised file binding rejected: HTTP %d body=%s", response.Code, response.Body.String())
+	}
+	var result auth.QuotaVerification
+	if err := json.Unmarshal(response.Body.Bytes(), &result); err != nil {
+		t.Fatal(err)
+	}
+	if !result.Passed || !result.Restored {
+		t.Fatalf("verification: %+v", result)
+	}
+	payload := []byte(`{"model":"gpt-6-astra","input":"Reply with exactly OK.","stream":true,"store":false}`)
+	stream, err := manager.ExecuteStream(context.Background(), []string{"codex"}, exec.Request{Model: "gpt-6-astra", Payload: payload}, exec.Options{Stream: true, SourceFormat: translator.FormatOpenAIResponse})
+	if err != nil {
+		t.Fatalf("normal selector still blocked: %v", err)
+	}
+	for chunk := range stream.Chunks {
+		if chunk.Err != nil {
+			t.Fatal(chunk.Err)
+		}
+	}
+	if _, err := manager.RefreshCredential(context.Background(), entry.ID, fp); err == nil {
+		t.Fatal("consumed token retried")
+	}
+	if executor.refreshes.Load() != 1 {
+		t.Fatal("unexpected OAuth refresh")
+	}
+	if calls.Load() != 2 {
+		t.Fatalf("calls=%d; expected one verification and one normal inference", calls.Load())
+	}
+	after, err := os.ReadFile(filepath.Join(directory, "fallback.json"))
+	if err != nil || !bytes.Equal(after, metadata) {
+		t.Fatal("fallback verification or normal request changed credential bytes")
+	}
+	t.Log("FALLBACK_HTTP status=200 passed=true restored=true; stale_fingerprint_rejected=true; credential_bytes_unchanged=true; verification_and_normal_inference_calls=2; no_additional_OAuth_refresh")
+}
