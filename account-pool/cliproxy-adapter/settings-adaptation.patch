+// GetAuthFileModelCatalog returns a bound Codex OAuth credential's model options
+// without changing registration, exclusions, or the credential itself.
+func (h *Handler) GetAuthFileModelCatalog(c *gin.Context) {
+	auth, ok := h.lookupAuthFile(c.Query("name"), c.Query("auth_index"))
+	if !ok {
+		c.JSON(http.StatusNotFound, gin.H{"error": "auth file not found"})
+		return
+	}
+	if !strings.EqualFold(auth.Provider, "codex") || auth.AuthKind() == "apikey" {
+		c.JSON(http.StatusUnprocessableEntity, gin.H{"error": "requires a Codex OAuth credential"})
+		return
+	}
+	models := registry.GetCodexModelsForPlan(auth.Attributes["plan_type"])
+	if len(models) == 0 {
+		c.JSON(http.StatusUnprocessableEntity, gin.H{"error": "Codex credential plan is unknown"})
+		return
+	}
+	ids := make([]string, 0, len(models))
+	seen := make(map[string]bool, len(models))
+	for _, model := range models {
+		if model != nil && !seen[model.ID] {
+			seen[model.ID] = true
+			ids = append(ids, model.ID)
+		}
+	}
+	// Keep custom registered aliases, but do not admit a built-in from a
+	// different tier while the live registry catches up after a plan change.
+	for _, model := range registry.GetGlobalRegistry().GetModelsForClient(auth.ID) {
+		if model != nil && !seen[model.ID] && registry.LookupStaticModelInfo(model.ID) == nil {
+			seen[model.ID] = true
+			ids = append(ids, model.ID)
+		}
+	}
+	c.JSON(http.StatusOK, ids)
+}
