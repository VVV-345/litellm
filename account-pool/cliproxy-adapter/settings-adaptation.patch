+func TestRefreshPersistenceConcurrentChange(t *testing.T) {
+	for _, change := range []string{"import", "disable", "remove", "reregister", "quota"} {
+		for _, failure := range []bool{false, true} {
+			name := change + map[bool]string{false: "_success", true: "_error"}[failure]
+			t.Run(name, func(t *testing.T) {
+				m, s, e, a := newRefreshPersistenceFixture(t)
+				if failure {
+					e.failure = &Error{HTTPStatus: 401, Code: "unauthorized", Message: "synthetic invalid"}
+				}
+				e.during = func() {
+					current, _ := m.GetByID(a.ID)
+					switch change {
+					case "import":
+						current.Metadata["access_token"] = "synthetic-imported"
+						current.Metadata["refresh_token"] = "synthetic-imported-refresh"
+					case "disable":
+						current.Disabled = true
+						current.Status = StatusDisabled
+					case "remove":
+						m.Remove(context.Background(), a.ID)
+						return
+					case "reregister":
+						m.Remove(context.Background(), a.ID)
+						_, err := m.Register(context.Background(), current)
+						if err != nil {
+							t.Fatal(err)
+						}
+						return
+					case "quota":
+						current.Quota = QuotaState{Exceeded: true, Reason: "credential_quota", NextRecoverAt: time.Now().Add(time.Hour)}
+						current.Unavailable = true
+						current.Status = StatusError
+						current.LastError = &Error{HTTPStatus: 429, Code: "quota"}
+					}
+					if _, err := m.Update(context.Background(), current); err != nil {
+						t.Fatal(err)
+					}
+				}
+				_, _ = m.RefreshAuth(context.Background(), a.ID)
+				current, exists := m.GetByID(a.ID)
+				if change == "remove" {
+					if exists {
+						t.Fatal("removed auth resurrected")
+					}
+					return
+				}
+				if !exists {
+					t.Fatal("auth lost")
+				}
+				switch change {
+				case "import":
+					if current.Metadata["access_token"] != "synthetic-imported" || s.stored.Metadata["refresh_token"] != "synthetic-imported-refresh" || hasUnauthorizedAuthFailure(current) {
+						t.Fatal("stale refresh overwrote import")
+					}
+				case "reregister":
+					if current.Metadata["access_token"] != "synthetic-old-access" || hasUnauthorizedAuthFailure(current) {
+						t.Fatal("stale refresh crossed registration epoch")
+					}
+				case "disable":
+					if !current.Disabled || current.Status != StatusDisabled {
+						t.Fatal("manual disable lost")
+					}
+					if !failure && s.stored.Metadata["refresh_token"] != "synthetic-new-refresh" {
+						t.Fatal("disabled auth lost rotated pair")
+					}
+				case "quota":
+					if !current.Quota.Exceeded || !current.Unavailable || current.LastError == nil || current.LastError.HTTPStatus != 429 {
+						t.Fatal("concurrent quota state lost")
+					}
+				}
+			})
+		}
+	}
