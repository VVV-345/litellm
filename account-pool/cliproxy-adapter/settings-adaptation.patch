+}
+func TestRefreshPersistencePendingSavePreservesNewUnauthorized(t *testing.T) {
+	m, s, e, a := newRefreshPersistenceFixture(t)
+	s.fail = true
+	_, _ = m.RefreshAuth(context.Background(), a.ID)
+	current, _ := m.GetByID(a.ID)
+	current.LastError = &Error{HTTPStatus: 401, Code: "unauthorized"}
+	current.Unavailable = true
+	current.Status = StatusError
+	_, _ = m.Update(context.Background(), current)
+	s.fail = false
+	if _, err := m.RefreshAuth(context.Background(), a.ID); err != nil {
+		t.Fatal(err)
+	}
+	current, _ = m.GetByID(a.ID)
+	if !hasUnauthorizedAuthFailure(current) || !current.Unavailable || e.calls != 1 {
+		t.Fatal("saving credentials cleared genuine upstream failure")
+	}
+}
+
+func TestRefreshPersistenceStaleWatcherCannotRestoreConsumedPair(t *testing.T) {
+	m, s, e, a := newRefreshPersistenceFixture(t)
+	s.fail = true
+	_, _ = m.RefreshAuth(context.Background(), a.ID)
+	_, _ = m.Update(WithSkipPersist(context.Background()), a.Clone())
+	current, _ := m.GetByID(a.ID)
+	if authAccessToken(current) != "synthetic-new-access" {
+		t.Fatal("stale watcher restored consumed pair")
+	}
+	s.fail = false
+	if _, err := m.RefreshAuth(context.Background(), a.ID); err != nil {
+		t.Fatal(err)
+	}
+	if e.calls != 1 || s.stored.Metadata["refresh_token"] != "synthetic-new-refresh" {
+		t.Fatal("stale watcher broke persistence retry")
+	}
+}
+func TestRefreshPersistenceOverlappingEntrypoints(t *testing.T) {
+	m, _, e, a := newRefreshPersistenceFixture(t)
+	entered, release := make(chan struct{}), make(chan struct{})
+	e.during = func() { close(entered); <-release }
+	finished := make(chan error, 9)
+	go func() { _, err := m.RefreshAuth(context.Background(), a.ID); finished <- err }()
+	<-entered
+	for i := 0; i < 4; i++ {
+		go func() {
+			_, err := m.RefreshAuthAfterUnauthorized(context.Background(), a.ID, "synthetic-old-access")
+			finished <- err
+		}()
+		go func() { m.refreshAuth(context.Background(), a.ID); finished <- nil }()
+	}
+	close(release)
+	for i := 0; i < 9; i++ {
+		if err := <-finished; err != nil {
+			t.Fatal(err)
+		}
+	}
+	if e.calls != 1 {
+		t.Fatalf("overlapping entrypoints rotated %d times", e.calls)
+	}
+}
+
+func TestRefreshPersistenceFailedRequestDoesNotRetryInvalidRefresh(t *testing.T) {
+	m, _, e, a := newRefreshPersistenceFixture(t)
+	e.failure = &Error{HTTPStatus: 401, Code: "unauthorized", Message: "synthetic invalid refresh"}
+	for i := 0; i < 2; i++ {
