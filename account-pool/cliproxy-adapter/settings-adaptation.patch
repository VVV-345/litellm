diff --git a/sdk/cliproxy/auth/credential_refresh.go b/sdk/cliproxy/auth/credential_refresh.go
new file mode 100644
index 0000000..d0c294e
--- /dev/null
+++ b/sdk/cliproxy/auth/credential_refresh.go
@@ -0,0 +1,149 @@
+// 公开单卡刷新协调入口和脱敏调度状态，不把刷新成功当作推理成功。
+package auth
+
+import (
+	"context"
+	"errors"
+	"time"
+)
+
+var ErrRefreshRejected = errors.New("refresh rejected; reauthorization required")
+var ErrRefreshStale = errors.New("credential changed; reload before refreshing")
+var ErrRefreshBackoff = errors.New("credential refresh is in backoff")
+var ErrRefreshJournal = errors.New("credential refresh not sent: durable state unavailable")
+
+type CredentialRefreshView struct {
+	AccessExpiresAt *time.Time `json:"access_expires_at"`
+	NextRefreshAt   *time.Time `json:"next_refresh_at"`
+	ScheduleReason  string     `json:"schedule_reason"`
+	LastAttemptAt   *time.Time `json:"last_attempt_at"`
+	LastSuccessAt   *time.Time `json:"last_success_at"`
+	LastResult      string     `json:"last_result"`
+	Running         bool       `json:"running"`
+	SavePending     bool       `json:"save_pending"`
+}
+
+type CredentialRefreshState struct {
+	Credential  string    `json:"credential"`
+	AttemptedAt time.Time `json:"attempted_at"`
+	SuccessAt   time.Time `json:"success_at"`
+	RetryAt     time.Time `json:"retry_at"`
+	Result      string    `json:"result"`
+}
+
+func markRefreshRejected(auth *Auth, failure *Error, at time.Time) {
+	if !accessFallbackBound(auth) {
+		auth.AccessFallback = &AccessFallbackState{Credential: refreshCredentialFingerprint(auth), Proxy: accessFallbackProxy(auth)}
+	} else {
+		auth.AccessFallback = auth.AccessFallback.Clone()
+	}
+	auth.AccessFallback.RefreshRejected = true
+	auth.AccessFallback.FailedAt = at
+	auth.AccessFallback.RefreshError = cloneError(failure)
+}
+
+func (m *Manager) beginCodexRefresh(ctx context.Context, auth *Auth, at time.Time) error {
+	lock := m.authRefreshLock(auth.ID)
+	lock.commitMu.Lock()
+	defer lock.commitMu.Unlock()
+	m.configCooldownMu.Lock()
+	defer m.configCooldownMu.Unlock()
+	m.mu.Lock()
+	current := m.auths[auth.ID]
+	if !sameRefreshCredential(auth, current) || current.Disabled || current.Status == StatusDisabled {
+		m.mu.Unlock()
+		return ErrRefreshStale
+	}
+	store := m.cooldownStore
+	if store == nil {
+		m.mu.Unlock()
+		return ErrRefreshJournal
+	}
+	previousAt, previousResult := current.refreshAttemptedAt, current.refreshLastResult
+	current.refreshAttemptedAt, current.refreshLastResult, current.refreshInProgress = at, "pending", true
+	m.mu.Unlock()
+	// 必须先落盘再发送；进程在回包前退出时，重启把 pending 视为结果未知。
+	saveCtx, cancel := context.WithTimeout(context.WithoutCancel(ctx), 15*time.Second)
+	defer cancel()
+	if m.persistCooldownStatesToLocked(saveCtx, store) {
+		return nil
+	}
+	m.mu.Lock()
+	if current := m.auths[auth.ID]; sameRefreshCredential(auth, current) {
+		current.refreshAttemptedAt, current.refreshLastResult, current.refreshInProgress = previousAt, previousResult, false
+	}
+	m.mu.Unlock()
+	return ErrRefreshJournal
+}
+
+func (m *Manager) RefreshCredential(ctx context.Context, id, fingerprint string) (*Auth, error) {
+	return m.refreshAuthCoordinated(ctx, id, "", false, fingerprint)
+}
+
+func (m *Manager) CredentialRefreshStatus(id string) CredentialRefreshView {
+	view := CredentialRefreshView{ScheduleReason: "unavailable", LastResult: "unknown"}
+	m.mu.RLock()
+	a := m.auths[id].Clone()
+	loop := m.refreshLoop
+	m.mu.RUnlock()
+	if a == nil {
+		return view
+	}
+	if expiry := accessFallbackExpiry(a); !expiry.IsZero() {
+		view.AccessExpiresAt = &expiry
+	}
+	if !a.refreshAttemptedAt.IsZero() {
+		at := a.refreshAttemptedAt
+		view.LastAttemptAt = &at
+	}
+	last := a.LastRefreshedAt
+	if last.IsZero() {
+		last, _ = authLastRefreshTimestamp(a)
+	}
+	if !last.IsZero() {
+		view.LastSuccessAt = &last
+	}
+	if a.refreshLastResult != "" {
+		view.LastResult = a.refreshLastResult
+	}
+	view.Running = a.refreshInProgress
+	view.SavePending = a.refreshSavePending
+	if view.SavePending {
+		view.LastResult = "save_pending"
+	}
+	switch {
+	case a.Disabled || a.Status == StatusDisabled:
+		view.ScheduleReason = "disabled"
+	case view.Running:
+		view.ScheduleReason = "running"
+	case a.refreshLastResult == "unknown_outcome" && !view.SavePending:
+		view.ScheduleReason = "refresh_outcome_unknown"
+	case hasUnauthorizedAuthFailure(a) && !view.SavePending:
+		view.ScheduleReason = "reauthorization_required"
+	case !authHasRefreshCredential(a) && !view.SavePending:
+		view.ScheduleReason = "no_refresh_token"
+	case loop == nil:
+		view.ScheduleReason = "scheduler_stopped"
+	default:
+		loop.mu.Lock()
+		_, dirty := loop.dirty[id]
+		if item := loop.index[id]; item != nil && !dirty {
+			at := item.next
+			view.NextRefreshAt = &at
+		}
+		loop.mu.Unlock()
+		switch {
+		case dirty:
+			view.ScheduleReason = "rescheduling"
+		case view.NextRefreshAt == nil:
+			view.ScheduleReason = "not_scheduled"
+		case view.SavePending:
+			view.ScheduleReason = "save_retry"
+		case a.NextRefreshAfter.After(time.Now()):
+			view.ScheduleReason = "backoff"
+		default:
+			view.ScheduleReason = "scheduled"
+		}
+	}
+	return view
+}
diff --git a/sdk/cliproxy/auth/credential_refresh_test.go b/sdk/cliproxy/auth/credential_refresh_test.go
