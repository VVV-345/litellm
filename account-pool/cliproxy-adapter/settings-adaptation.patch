+}
+func TestRefreshPersistenceRequestCanUseUnsavedPair(t *testing.T) {
+	m, s, e, a := newRefreshPersistenceFixture(t)
+	s.fail = true
+	next, retry := m.tryRefreshAfterUnauthorized(context.Background(), a, &Error{HTTPStatus: 401}, false)
+	if !retry || next == nil || authAccessToken(next) != "synthetic-new-access" || e.calls != 1 {
