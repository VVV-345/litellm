+	if err == nil || strings.Contains(err.Error(), "synthetic-secret") || !strings.Contains(err.Error(), "refresh_token_reused") {
+		t.Fatalf("unsafe refresh error: %v", err)
+	}
+}
+
+type auditLostRefreshBody struct{}
+
+func (auditLostRefreshBody) Read([]byte) (int, error) { return 0, io.ErrUnexpectedEOF }
+func (auditLostRefreshBody) Close() error             { return nil }
+
+func TestAuditRefreshResponseLossMustNotReplayUsedToken(t *testing.T) {
+	resetCodexRefreshGroupForTest()
+	t.Cleanup(resetCodexRefreshGroupForTest)
+	var received []string
+	rotated := false
+	auth := &CodexAuth{httpClient: &http.Client{Transport: roundTripFunc(func(req *http.Request) (*http.Response, error) {
+		raw, err := io.ReadAll(req.Body)
+		if err != nil {
+			t.Fatal(err)
+		}
+		form, err := url.ParseQuery(string(raw))
+		if err != nil {
+			t.Fatal(err)
+		}
+		received = append(received, form.Get("refresh_token"))
+		if len(received) == 1 {
+			rotated = true
+			return &http.Response{StatusCode: 200, Body: auditLostRefreshBody{}, Header: make(http.Header), Request: req}, nil
+		}
+		return &http.Response{StatusCode: 400, Body: io.NopCloser(strings.NewReader(`{"error":"invalid_grant","code":"refresh_token_reused"}`)), Header: make(http.Header), Request: req}, nil
+	})}}
+	_, err := auth.RefreshTokensWithRetry(context.Background(), "TEST_OLD_A", 3)
+	t.Logf("simulated_server_rotated_A_to_B=%t; observed_refresh_posts=%d; sent_test_values=%v; client_error=%v", rotated, len(received), received, err)
+	if !rotated || err == nil {
+		t.Fatal("fault fixture did not exercise a lost successful rotation")
+	}
+	if len(received) != 1 {
+		t.Fatalf("unsafe replay: expected no retry after an indeterminate sent refresh, got %d posts", len(received))
+	}
+}
+
+func TestRefreshUncertainResponsesDoNotReplay(t *testing.T) {
+	for _, tc := range []struct {
+		name    string
+		status  int
+		body    string
+		network error
+		unknown bool
+	}{
+		{name: "request interrupted", network: io.ErrUnexpectedEOF, unknown: true},
+		{name: "upstream 502", status: 502, body: `upstream unavailable`, unknown: true},
+		{name: "malformed success", status: 200, body: `{`, unknown: true},
+		{name: "missing access", status: 200, body: `{"refresh_token":"fixture-new"}`, unknown: true},
+		{name: "empty access", status: 200, body: `{"access_token":" "}`, unknown: true},
+		{name: "dial failed", network: &net.OpError{Op: "dial", Err: errors.New("connection refused")}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			resetCodexRefreshGroupForTest()
+			t.Cleanup(resetCodexRefreshGroupForTest)
+			calls := 0
+			auth := &CodexAuth{httpClient: &http.Client{Transport: roundTripFunc(func(req *http.Request) (*http.Response, error) {
+				calls++
+				if tc.network != nil {
+					return nil, tc.network
+				}
+				return &http.Response{StatusCode: tc.status, Body: io.NopCloser(strings.NewReader(tc.body)), Header: make(http.Header), Request: req}, nil
+			})}}
+			_, err := auth.RefreshTokensWithRetry(context.Background(), "fixture-"+tc.name, 1)
+			var outcome interface{ RefreshOutcomeUnknown() bool }
+			unknown := errors.As(err, &outcome) && outcome.RefreshOutcomeUnknown()
+			if err == nil || unknown != tc.unknown || isNonRetryableRefreshErr(err) != tc.unknown || calls != 1 {
+				t.Fatalf("unknown=%t want=%t; posts=%d; error=%v", unknown, tc.unknown, calls, err)
+			}
+		})
+	}
+}
