+func TestCodexModelCatalogUsesBoundPlanWithoutUnregisteringExclusions(t *testing.T) {
+	manager := coreauth.NewManager(nil, nil, nil)
+	auth, err := manager.Register(context.Background(), &coreauth.Auth{
+		ID: "model-catalog-fixture.json", FileName: "model-catalog-fixture.json", Provider: "codex",
+		Attributes: map[string]string{"plan_type": "free", "excluded_models": "fixture-disabled"},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, err = manager.Register(context.Background(), &coreauth.Auth{
+		ID: "unknown-plan.json", FileName: "unknown-plan.json", Provider: "codex",
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	reg := registry.GetGlobalRegistry()
+	reg.RegisterClient(auth.ID, "codex", []*registry.ModelInfo{{ID: "fixture-registered-alias"}, {ID: "gpt-5.6-sol"}})
+	defer reg.UnregisterClient(auth.ID)
+	h := NewHandlerWithoutConfigFilePath(&config.Config{}, manager)
+	query := func(name, index string) *httptest.ResponseRecorder {
+		rec := httptest.NewRecorder()
+		ctx, _ := gin.CreateTestContext(rec)
+		ctx.Request = httptest.NewRequest(http.MethodGet, "/auth-files/model-catalog?"+url.Values{
+			"name": {name}, "auth_index": {index},
+		}.Encode(), nil)
+		h.GetAuthFileModelCatalog(ctx)
+		return rec
+	}
+
+	rec := query(auth.FileName, auth.EnsureIndex())
+	var ids []string
+	if rec.Code != http.StatusOK || json.Unmarshal(rec.Body.Bytes(), &ids) != nil {
+		t.Fatalf("catalog response: %d %s", rec.Code, rec.Body.String())
+	}
+	var want []string
+	for _, model := range registry.GetCodexFreeModels() {
+		want = append(want, model.ID)
+	}
+	want = append(want, "fixture-registered-alias")
+	if !slices.Equal(ids, want) {
+		t.Fatalf("catalog = %v, want free plan + registered alias = %v", ids, want)
+	}
+	if got := reg.GetModelsForClient(auth.ID); len(got) != 2 {
+		t.Fatalf("live registry changed: %v", got)
+	}
+	if got := query(auth.FileName, "other-index").Code; got != http.StatusNotFound {
+		t.Fatalf("mismatched credential returned %d", got)
+	}
+	if got := query("unknown-plan.json", "").Code; got != http.StatusUnprocessableEntity {
+		t.Fatalf("unknown tier returned %d instead of failing closed", got)
+	}
+}
