index 0000000000000000000000000000000000000000..eafe8d812f7ff5331bf1a06f6d11cbe414088d3f
--- /dev/null
+++ b/sdk/cliproxy/auth/error_scope.go
@@ -0,0 +1,27 @@
+// 仅以晚于聚合错误的成功模型状态证明错误属于模型，未知来源保持保守处理。
+package auth
+
+import "reflect"
+
+func ModelScopedAuthenticationError(a *Auth) bool {
+	if a == nil || a.Disabled || a.Status != StatusError || a.Unavailable || !a.NextRetryAfter.IsZero() || a.LastError == nil || a.Quota.Reason == "credential_quota" {
+		return false
+	}
+	switch a.LastError.Code {
+	case "refresh_token_invalidated", "refresh_token_reused", "invalid_api_key":
+		return false
+	}
+	matched, healthy := false, false
+	for _, state := range a.ModelStates {
+		if state == nil {
+			continue
+		}
+		if state.LastError != nil && reflect.DeepEqual(state.LastError, a.LastError) && state.StatusMessage == a.StatusMessage {
+			matched = true
+		}
+		if state.Status == StatusActive && !state.Unavailable && state.LastError == nil && !state.UpdatedAt.IsZero() && !state.UpdatedAt.Before(a.UpdatedAt) {
+			healthy = true
+		}
+	}
+	return matched && healthy
+}
