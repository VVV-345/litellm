index 0000000..cb43789
--- /dev/null
+++ b/sdk/cliproxy/auth/credential_refresh_test.go
@@ -0,0 +1,403 @@
+// 验证手动刷新去重、待保存补偿和重启后的调度状态。
+package auth
+
+import (
+	"context"
+	"crypto/sha256"
+	"errors"
+	"fmt"
+	"testing"
+	"time"
+)
+
+type interruptedRefreshExecutor struct {
+	unknownRefreshExecutor
+	during func()
+}
+
+type unchangedCodexRefreshExecutor struct {
+	quotaRecoveryExecutor
+	during func()
+}
+
+func (e *unchangedCodexRefreshExecutor) Refresh(_ context.Context, auth *Auth) (*Auth, error) {
+	e.refreshes++
+	e.during()
+	return auth, nil
+}
+
+func TestStalePendingUpdateCannotReplaceCompletedRefreshAwaitingSave(t *testing.T) {
+	store := &refreshPersistenceStore{}
+	m := NewManager(store, nil, nil)
+	m.cooldownStore = NewFileCooldownStateStore(t.TempDir())
+	e := &unchangedCodexRefreshExecutor{}
+	m.RegisterExecutor(e)
+	a, err := m.Register(context.Background(), &Auth{ID: "unchanged-pair", Provider: "codex", Status: StatusActive, Metadata: map[string]any{"access_token": "fixture-access", "refresh_token": "fixture-refresh"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	var stale *Auth
+	e.during = func() { stale, _ = m.GetByID(a.ID) }
+	store.fail = true
+	fp := fmt.Sprintf("%x", sha256.Sum256([]byte("fixture-access")))
+	if _, err := manualRefresh(t, m, a.ID, fp); !errors.Is(err, ErrRefreshPersistence) {
+		t.Fatal(err)
+	}
+	stale.Disabled, stale.Status = true, StatusDisabled
+	_, _ = m.Update(context.Background(), stale)
+	if m.CredentialRefreshStatus(a.ID).LastResult != "save_pending" {
+		t.Fatal("save pending was lost")
+	}
+	store.fail = false
+	if _, err := manualRefresh(t, m, a.ID, fp); err != nil {
+		t.Fatal(err)
+	}
+	if m.CredentialRefreshStatus(a.ID).LastResult != "saved" || e.refreshes != 1 {
+		t.Fatalf("completed refresh replaced by stale pending: status=%+v calls=%d", m.CredentialRefreshStatus(a.ID), e.refreshes)
+	}
+}
+
+type pendingRefreshExecutor struct {
+	unknownRefreshExecutor
+	sent    chan struct{}
+	release chan struct{}
+}
+
+func (e *pendingRefreshExecutor) Refresh(context.Context, *Auth) (*Auth, error) {
+	e.refreshes++
+	if e.refreshes == 1 {
+		close(e.sent)
+		<-e.release
+	}
+	return nil, unknownRefreshResult{}
+}
+
+func TestRestartDuringRefreshDoesNotReplayThePendingCredential(t *testing.T) {
+	m := NewManager(nil, nil, nil)
+	store := NewFileCooldownStateStore(t.TempDir())
+	m.cooldownStore = store
+	e := &pendingRefreshExecutor{sent: make(chan struct{}), release: make(chan struct{})}
+	m.RegisterExecutor(e)
+	a, err := m.Register(context.Background(), &Auth{ID: "pending", Provider: "codex", Status: StatusActive, Metadata: map[string]any{"access_token": "fixture-access", "refresh_token": "fixture-refresh"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	fp := fmt.Sprintf("%x", sha256.Sum256([]byte("fixture-access")))
+	done := make(chan error, 1)
+	go func() { _, err := m.RefreshCredential(context.Background(), a.ID, fp); done <- err }()
+	<-e.sent
+	restored := NewManager(nil, nil, nil)
+	restored.cooldownStore = store
+	restored.RegisterExecutor(e)
+	if _, err := restored.Register(context.Background(), a); err != nil {
+		t.Fatal(err)
+	}
+	if err := restored.RestoreCooldownStates(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	_, refreshErr := manualRefresh(t, restored, a.ID, fp)
+	close(e.release)
+	<-done
+	if !errors.Is(refreshErr, ErrRefreshRejected) || e.refreshes != 1 {
+		t.Fatalf("pending credential replayed after restart: calls=%d err=%v", e.refreshes, refreshErr)
+	}
+	current, _ := restored.GetByID(a.ID)
+	if restored.CredentialRefreshStatus(a.ID).LastResult != "unknown_outcome" || restored.shouldRefresh(current, time.Now().Add(24*time.Hour)) {
+		t.Fatal("restored pending credential was not paused")
+	}
+}
+
+func TestCodexRefreshRequiresDurablePendingBeforeSending(t *testing.T) {
+	for _, missing := range []bool{false, true} {
+		t.Run(fmt.Sprintf("missing=%t", missing), func(t *testing.T) {
+			m := NewManager(nil, nil, nil)
+			store := NewFileCooldownStateStore(t.TempDir())
+			if !missing {
+				m.cooldownStore = failFallbackStateSave{store}
+			}
+			e := &unknownRefreshExecutor{}
+			m.RegisterExecutor(e)
+			a, err := m.Register(context.Background(), &Auth{ID: "journal", Provider: "codex", Status: StatusActive, Metadata: map[string]any{"access_token": "fixture-access", "refresh_token": "fixture-refresh"}})
+			if err != nil {
+				t.Fatal(err)
+			}
+			fp := fmt.Sprintf("%x", sha256.Sum256([]byte("fixture-access")))
+			if _, err := manualRefresh(t, m, a.ID, fp); err == nil || e.refreshes != 0 {
+				t.Fatalf("refresh sent without durable pending: calls=%d err=%v", e.refreshes, err)
+			}
+			if m.CredentialRefreshStatus(a.ID).Running {
+				t.Fatal("failed journal write left refresh running")
+			}
+			m.cooldownStore = store
+			_, _ = manualRefresh(t, m, a.ID, fp)
+			if e.refreshes != 1 {
+				t.Fatalf("unsent refresh could not retry after persistence recovered: calls=%d", e.refreshes)
+			}
+		})
+	}
+}
+
+func TestStaleUpdateCannotErasePendingRefreshAcrossRestart(t *testing.T) {
+	m := NewManager(nil, nil, nil)
+	store := NewFileCooldownStateStore(t.TempDir())
+	m.cooldownStore = store
+	e := &pendingRefreshExecutor{sent: make(chan struct{}), release: make(chan struct{})}
+	m.RegisterExecutor(e)
+	a, err := m.Register(context.Background(), &Auth{ID: "stale-pending", Provider: "codex", Status: StatusActive, Metadata: map[string]any{"access_token": "fixture-access", "refresh_token": "fixture-refresh"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	stale := a.Clone()
+	stale.refreshAttemptedAt, stale.refreshLastResult = time.Now().Add(-time.Hour), "failed"
+	if _, err := m.Update(context.Background(), stale); err != nil {
+		t.Fatal(err)
+	}
+	stale, _ = m.GetByID(a.ID)
+	fp := fmt.Sprintf("%x", sha256.Sum256([]byte("fixture-access")))
+	done := make(chan error, 1)
+	go func() { _, err := m.RefreshCredential(context.Background(), a.ID, fp); done <- err }()
+	<-e.sent
+	stale.ProxyURL = "http://fixture-proxy.test:8080"
+	if _, err := m.Update(context.Background(), stale); err != nil {
+		t.Fatal(err)
+	}
+	m.PersistCooldownStates(context.Background())
+	restored := NewManager(nil, nil, nil)
+	restored.cooldownStore = store
+	restored.RegisterExecutor(e)
+	_, _ = restored.Register(context.Background(), a)
+	if err := restored.RestoreCooldownStates(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	_, refreshErr := manualRefresh(t, restored, a.ID, fp)
+	close(e.release)
+	<-done
+	if !errors.Is(refreshErr, ErrRefreshRejected) || e.refreshes != 1 {
+		t.Fatalf("stale update erased pending: calls=%d err=%v", e.refreshes, refreshErr)
+	}
+}
+
+func (e *interruptedRefreshExecutor) Refresh(context.Context, *Auth) (*Auth, error) {
+	e.refreshes++
+	if e.during != nil {
+		e.during()
+	}
+	return nil, unknownRefreshResult{}
+}
+
+func TestUnknownRefreshPreservesReplayGuardAcrossConcurrentStateChanges(t *testing.T) {
+	for _, disabled := range []bool{false, true} {
+		t.Run(fmt.Sprintf("disabled=%t", disabled), func(t *testing.T) {
+			m := NewManager(nil, nil, nil)
+			m.cooldownStore = NewFileCooldownStateStore(t.TempDir())
+			e := &interruptedRefreshExecutor{}
+			m.RegisterExecutor(e)
+			a, err := m.Register(context.Background(), &Auth{ID: "interrupted", Provider: "codex", Status: StatusActive, Metadata: map[string]any{"access_token": "fixture-access", "refresh_token": "fixture-refresh"}})
+			if err != nil {
+				t.Fatal(err)
+			}
+			e.during = func() {
+				current, _ := m.GetByID(a.ID)
+				if disabled {
+					current.Disabled, current.Status = true, StatusDisabled
+				} else {
+					current.LastError = &Error{HTTPStatus: 429, Code: "quota_exhausted"}
+					current.Unavailable = true
+				}
+				if _, err := m.Update(context.Background(), current); err != nil {
+					t.Fatal(err)
+				}
+			}
+			fp := fmt.Sprintf("%x", sha256.Sum256([]byte("fixture-access")))
+			_, _ = manualRefresh(t, m, a.ID, fp)
+			current, _ := m.GetByID(a.ID)
+			if current.refreshLastResult != "unknown_outcome" || !accessFallbackBound(current) || !current.AccessFallback.RefreshRejected {
+				t.Errorf("missing replay guard: result=%q fallback=%+v", current.refreshLastResult, current.AccessFallback)
+			}
+			if disabled {
+				if !current.Disabled || current.Status != StatusDisabled {
+					t.Fatal("manual disable overwritten")
+				}
+				current.Disabled, current.Status = false, StatusActive
+				_, _ = m.Update(context.Background(), current)
+			} else if current.LastError == nil || current.LastError.Code != "quota_exhausted" {
+				t.Fatal("concurrent quota error overwritten")
+			}
+			if _, err := manualRefresh(t, m, a.ID, fp); !errors.Is(err, ErrRefreshRejected) || e.refreshes != 1 {
+				t.Fatalf("old token replayed: calls=%d err=%v", e.refreshes, err)
+			}
+		})
+	}
+}
+
+func manualRefresh(t *testing.T, m *Manager, id, fingerprint string) (*Auth, error) {
+	t.Helper()
+	api, ok := any(m).(interface {
+		RefreshCredential(context.Context, string, string) (*Auth, error)
+	})
+	if !ok {
+		t.Fatal("manual credential refresh capability missing")
+	}
+	return api.RefreshCredential(context.Background(), id, fingerprint)
+}
+
+func TestManualCredentialRefreshDeduplicatesAndRetriesSave(t *testing.T) {
+	m, store, e, a := newRefreshPersistenceFixture(t)
+	fp := fmt.Sprintf("%x", sha256.Sum256([]byte("synthetic-old-access")))
+	store.fail = true
+	if _, err := manualRefresh(t, m, a.ID, fp); err == nil {
+		t.Fatal("save failure hidden")
+	}
+	store.fail = false
+	if _, err := manualRefresh(t, m, a.ID, fp); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := manualRefresh(t, m, a.ID, fp); err == nil {
+		t.Fatal("stale duplicate accepted")
+	}
+	if e.calls != 1 {
+		t.Fatalf("rotated %d times", e.calls)
+	}
+}
+
+func TestManualCredentialRefreshNeverReusesRejectedToken(t *testing.T) {
+	m, _, e, a := newRefreshPersistenceFixture(t)
+	e.failure = &Error{HTTPStatus: 401, Code: "refresh_token_reused"}
+	fp := fmt.Sprintf("%x", sha256.Sum256([]byte("synthetic-old-access")))
+	for i := 0; i < 2; i++ {
+		if _, err := manualRefresh(t, m, a.ID, fp); err == nil {
+			t.Fatal("rejected refresh accepted")
+		}
+	}
+	if e.calls != 1 {
+		t.Fatalf("rejected token retried %d times", e.calls)
+	}
+}
+
+func TestFallbackRejectedRefreshNotScheduledAfterRequestSuccess(t *testing.T) {
+	m, _, a := fallbackFixture(t)
+	a.LastError = nil
+	a.StatusMessage = ""
+	a.Status = StatusActive
+	a.Unavailable = false
+	_, _ = m.Update(context.Background(), a)
+	current, _ := m.GetByID(a.ID)
+	if _, ok := nextRefreshCheckAt(time.Now(), current, time.Second); ok {
+		t.Fatal("rejected refresh scheduled after request state changed")
+	}
+}
+
+func TestCredentialRefreshOutcomeSurvivesRestart(t *testing.T) {
+	m, _, e, a := newRefreshPersistenceFixture(t)
+	store := NewFileCooldownStateStore(t.TempDir())
+	m.cooldownStore = store
+	e.failure = &Error{HTTPStatus: 503, Code: "upstream_unavailable"}
+	fp := fmt.Sprintf("%x", sha256.Sum256([]byte("synthetic-old-access")))
+	_, _ = manualRefresh(t, m, a.ID, fp)
+	restarted := NewManager(nil, nil, nil)
+	restarted.cooldownStore = store
+	if _, err := restarted.Register(context.Background(), a); err != nil {
+		t.Fatal(err)
+	}
+	if err := restarted.RestoreCooldownStates(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	status := restarted.CredentialRefreshStatus(a.ID)
+	if status.LastResult != "failed" || status.LastAttemptAt == nil {
+		t.Fatalf("lost outcome: %+v", status)
+	}
+	current, _ := restarted.GetByID(a.ID)
+	if !current.NextRefreshAfter.After(time.Now()) {
+		t.Fatal("lost refresh backoff")
+	}
+}
+
+func TestManualCredentialRefreshRejectsConsumedTokenAfterSuccessfulAccess(t *testing.T) {
+	m, e, a := fallbackFixture(t)
+	a.LastError = nil
+	a.Status = StatusActive
+	a.Unavailable = false
+	_, _ = m.Update(context.Background(), a)
+	fp := fmt.Sprintf("%x", sha256.Sum256([]byte(authAccessToken(a))))
+	_, err := manualRefresh(t, m, a.ID, fp)
+	if err == nil || e.refreshes != 1 {
+		t.Fatalf("consumed refresh retried: err=%v calls=%d", err, e.refreshes)
+	}
+}
+
+func TestCredentialRefreshWatcherPreservesOutcome(t *testing.T) {
+	m, _, _, a := newRefreshPersistenceFixture(t)
+	fp := fmt.Sprintf("%x", sha256.Sum256([]byte("synthetic-old-access")))
+	current, err := manualRefresh(t, m, a.ID, fp)
+	if err != nil {
+		t.Fatal(err)
+	}
+	current.refreshAttemptedAt = time.Time{}
+	current.refreshLastResult = ""
+	current.refreshInProgress = false
+	if _, err = m.Update(context.Background(), current); err != nil {
+		t.Fatal(err)
+	}
+	status := m.CredentialRefreshStatus(a.ID)
+	if status.LastResult != "saved" || status.LastAttemptAt == nil {
+		t.Fatalf("watcher erased refresh result: %+v", status)
+	}
+}
+
+type unknownRefreshResult struct{}
+
+func (unknownRefreshResult) Error() string               { return "refresh_outcome_unknown: response incomplete" }
+func (unknownRefreshResult) RefreshOutcomeUnknown() bool { return true }
+
+type unknownRefreshExecutor struct{ quotaRecoveryExecutor }
+
+func (e *unknownRefreshExecutor) Refresh(context.Context, *Auth) (*Auth, error) {
+	e.refreshes++
+	return nil, unknownRefreshResult{}
+}
+func TestUnknownRefreshOutcomePausesReplayAndAllowsBoundAccessAfterRestart(t *testing.T) {
+	m := NewManager(nil, nil, nil)
+	e := &unknownRefreshExecutor{}
+	m.RegisterExecutor(e)
+	a, err := m.Register(context.Background(), &Auth{ID: "quota-first", Provider: "codex", Status: StatusActive, Metadata: map[string]any{"access_token": "synthetic-old-access", "refresh_token": "synthetic-old-refresh", "expired": time.Now().Add(time.Hour).Format(time.RFC3339)}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	store := NewFileCooldownStateStore(t.TempDir())
+	m.cooldownStore = store
+	fp := fmt.Sprintf("%x", sha256.Sum256([]byte("synthetic-old-access")))
+	for i := 0; i < 2; i++ {
+		_, _ = manualRefresh(t, m, a.ID, fp)
+	}
+	status := m.CredentialRefreshStatus(a.ID)
+	if e.refreshes != 1 || status.ScheduleReason != "refresh_outcome_unknown" {
+		t.Fatalf("unknown outcome replayed or mislabeled: calls=%d status=%+v", e.refreshes, status)
+	}
+	current, _ := m.GetByID(a.ID)
+	if view := AccessTokenFallbackStatus(current, time.Now()); view.FailureSource != "refresh" {
+		t.Fatalf("valid access was not offered for verification: %+v", view)
+	}
+	restarted := NewManager(nil, nil, nil)
+	restarted.RegisterExecutor(e)
+	restarted.cooldownStore = store
+	_, _ = restarted.Register(context.Background(), a)
+	if err := restarted.RestoreCooldownStates(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	_, _ = manualRefresh(t, restarted, a.ID, fp)
+	current, _ = restarted.GetByID(a.ID)
+	if e.refreshes != 1 || restarted.shouldRefresh(current, time.Now().Add(24*time.Hour)) {
+		t.Fatalf("unknown outcome retried after restart: calls=%d", e.refreshes)
+	}
+	current.Metadata[accessFallbackSetting] = true
+	current.Metadata["expired"] = time.Now().Add(time.Hour).Format(time.RFC3339)
+	_, _ = restarted.Update(context.Background(), current)
+	proof := restarted.VerifyAccessTokenFallback(context.Background(), a.ID, "gpt-6-astra", fp)
+	if !proof.Passed || !proof.Restored {
+		t.Fatalf("access could not recover: %+v", proof)
+	}
+	_, _ = manualRefresh(t, restarted, a.ID, fp)
+	if e.refreshes != 1 {
+		t.Fatal("successful access replayed unknown refresh")
+	}
+}
