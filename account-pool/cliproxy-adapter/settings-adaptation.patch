+			t.Fatal("invalid refresh accepted")
+		}
+	}
+	if e.calls != 1 {
+		t.Fatalf("invalid refresh retried by stale request: %d", e.calls)
+	}
+}
+
+func TestRefreshPersistenceCommitPreservesNewerRequestState(t *testing.T) {
+	m, _, _, a := newRefreshPersistenceFixture(t)
+	rotated := a.Clone()
+	rotated.Metadata["access_token"] = "synthetic-new-access"
+	rotated.refreshSavePending = true
+	latest, _ := m.GetByID(a.ID)
+	latest.Status = StatusError
+	latest.StatusMessage = "quota"
+	latest.Unavailable = true
+	latest.LastError = &Error{HTTPStatus: 429, Code: "quota"}
+	latest.ModelStates = map[string]*ModelState{"other": {Status: StatusError, Unavailable: true, LastError: &Error{HTTPStatus: 429, Code: "quota"}, NextRetryAfter: time.Now().Add(time.Hour)}}
+	if _, err := m.Update(context.Background(), latest); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := m.Update(context.Background(), rotated); err != nil {
+		t.Fatal(err)
+	}
+	current, _ := m.GetByID(a.ID)
+	if current.LastError == nil || current.LastError.HTTPStatus != 429 || current.Status != StatusError || !current.Unavailable {
+		t.Fatal("refresh commit overwrote newer request state")
+	}
+	if authAccessToken(current) != "synthetic-new-access" {
+		t.Fatal("state merge discarded rotation")
+	}
+}
