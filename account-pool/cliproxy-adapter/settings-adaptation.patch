+// 单卡额度恢复使用现有 Codex 执行器验证，不调用刷新、重试或备用账号。
+package auth
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"reflect"
+	"strings"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/registry"
+	exec "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/executor"
+	"github.com/router-for-me/CLIProxyAPI/v7/sdk/translator"
+	"github.com/tidwall/gjson"
+)
+
+type QuotaVerification struct {
+	Passed   bool   `json:"passed"`
+	Restored bool   `json:"restored"`
+	Reason   string `json:"reason"`
+}
+
+func (m *Manager) VerifyCodexQuota(ctx context.Context, authID, model string, recover bool, expected ...string) QuotaVerification {
+	snapshot, ok := m.GetByID(authID)
+	if !ok || snapshot.Provider != "codex" || snapshot.Disabled || snapshot.Status == StatusDisabled || strings.TrimSpace(model) == "" {
+		return QuotaVerification{Reason: "blocked"}
+	}
+	if len(expected) > 0 {
+		digest := sha256.Sum256([]byte(authAccessToken(snapshot)))
+		if hex.EncodeToString(digest[:]) != expected[0] || snapshot.Attributes["api_key"] != "" {
+			return QuotaVerification{Reason: "credential_changed"}
+		}
+	}
+	executor, ok := m.Executor("codex")
+	if !ok {
+		return QuotaVerification{Reason: "unsupported"}
+	}
+	ctx, cancel := context.WithTimeout(ctx, 45*time.Second)
+	defer cancel()
+	payload, _ := json.Marshal(map[string]any{"model": model, "instructions": "Reply with exactly OK.", "input": []any{map[string]any{"role": "user", "content": []any{map[string]any{"type": "input_text", "text": "Reply with exactly OK."}}}}, "stream": true, "store": false, "tools": []any{}, "reasoning": map[string]any{"effort": "low"}})
+	// 直接复用正常 HTTP 模型执行器，不经过会在 401 自动 Refresh 的重试编排。
+	stream, err := executor.ExecuteStream(ctx, snapshot.Clone(), exec.Request{Model: model, Payload: payload}, exec.Options{Stream: true, SourceFormat: translator.FormatOpenAIResponse, OriginalRequest: payload})
+	if err != nil {
+		if statusCodeFromError(err) == 401 {
+			return QuotaVerification{Reason: "authentication_failed"}
+		}
+		return QuotaVerification{Reason: "inference_failed"}
+	}
+	if stream == nil || stream.Chunks == nil {
+		return QuotaVerification{Reason: "incomplete"}
+	}
+	buffer := []byte{}
+	complete := false
+	for !complete {
+		select {
+		case <-ctx.Done():
+			return QuotaVerification{Reason: "timeout"}
+		case chunk, open := <-stream.Chunks:
+			if !open {
+				return QuotaVerification{Reason: "incomplete"}
+			}
+			if chunk.Err != nil {
+				if statusCodeFromError(chunk.Err) == 401 {
+					return QuotaVerification{Reason: "authentication_failed"}
+				}
+				return QuotaVerification{Reason: "inference_failed"}
+			}
+			buffer = append(buffer, chunk.Payload...)
+			if len(buffer) > 512*1024 {
+				return QuotaVerification{Reason: "response_limit"}
+			}
+			for _, line := range bytes.Split(buffer, []byte("\n")) {
+				if !bytes.HasPrefix(line, []byte("data:")) {
+					continue
+				}
+				body := bytes.TrimSpace(bytes.TrimPrefix(line, []byte("data:")))
+				if !gjson.ValidBytes(body) {
+					continue
+				}
+				event := gjson.GetBytes(body, "type").String()
+				if event == "error" || event == "response.failed" || event == "response.incomplete" {
+					return QuotaVerification{Reason: "inference_failed"}
+				}
+				if event == "response.completed" && gjson.GetBytes(body, "response.status").String() == "completed" {
+					text := ""
+					for _, item := range gjson.GetBytes(body, "response.output").Array() {
+						for _, part := range item.Get("content").Array() {
+							if part.Get("type").String() == "output_text" {
+								text += part.Get("text").String()
+							}
+						}
+					}
+					if strings.TrimSpace(text) != "OK" {
+						return QuotaVerification{Reason: "unexpected_reply"}
+					}
+					complete = true
+				}
+			}
+		}
+	}
+	if !recover {
+		return QuotaVerification{Passed: true, Reason: "verified"}
+	}
+	return m.commitQuotaVerification(ctx, snapshot, model)
+}
+
+func recoverableQuotaError(err *Error, message string) bool {
+	if err != nil {
+		if err.StatusCode() == 401 || err.Code == "unauthorized" {
+			return true
+		}
+		// HTTP 429 也可能是独立的容量或速率限制，不能仅凭状态码清除。
+		switch err.Code {
+		case "usage_limit_reached", "insufficient_quota", "quota_exceeded", "quota_exhausted":
+			return true
+		default:
+			return false
+		}
+	}
+	return message == "" || message == "unauthorized"
+}
+
+func (m *Manager) commitQuotaVerification(ctx context.Context, before *Auth, model string) QuotaVerification {
+	m.configCooldownMu.Lock()
+	defer m.configCooldownMu.Unlock()
+	m.mu.Lock()
+	current := m.auths[before.ID]
+	if current == nil || current.Generation != before.Generation || current.RegistrationEpoch != before.RegistrationEpoch ||
+		current.Disabled || current.Status == StatusDisabled || !reflect.DeepEqual(current.Metadata, before.Metadata) ||
+		!reflect.DeepEqual(current.Attributes, before.Attributes) || current.ProxyURL != before.ProxyURL {
+		m.mu.Unlock()
+		return QuotaVerification{Passed: true, Reason: "state_changed"}
+	}
+	if !recoverableQuotaError(current.LastError, current.StatusMessage) ||
+		current.Unavailable && current.LastError == nil && current.StatusMessage == "" && !current.Quota.Exceeded ||
+		current.Quota.Exceeded && current.Quota.Reason != "quota" && current.Quota.Reason != "credential_quota" {
+		m.mu.Unlock()
+		return QuotaVerification{Passed: true, Reason: "independent_block"}
+	}
+	key := canonicalModelKey(model)
+	if state := current.ModelStates[key]; state != nil && (state.Status == StatusDisabled || !recoverableQuotaError(state.LastError, state.StatusMessage) || state.Unavailable && state.LastError == nil && !state.Quota.Exceeded || state.Quota.Exceeded && state.Quota.Reason != "quota" && state.Quota.Reason != "credential_quota") {
+		m.mu.Unlock()
+		return QuotaVerification{Passed: true, Reason: "independent_block"}
+	}
+	if m.cooldownStore == nil {
+		m.mu.Unlock()
+		return QuotaVerification{Passed: true, Reason: "persistence_unavailable"}
+	}
+	now := time.Now()
+	next := current.Clone()
+	next.Status = StatusActive
+	next.StatusMessage = ""
+	next.LastError = nil
+	next.Unavailable = false
+	next.NextRetryAfter = time.Time{}
+	next.Quota = QuotaState{}
+	if next.ModelStates == nil {
+		next.ModelStates = make(map[string]*ModelState)
+	}
+	next.ModelStates[key] = &ModelState{Status: StatusActive, UpdatedAt: now}
+	next.Generation++
+	next.UpdatedAt = now
+	records := []CooldownStateRecord{}
+	for id, a := range m.auths {
+		if id == next.ID {
+			a = next
+		}
+		records = append(records, m.cooldownStateRecordsForAuthLocked(a, now)...)
+	}
+	// 只提交冷却元数据；不调用 token Store.Save，不改写认证文件正文。
+	if err := m.cooldownStore.Save(ctx, records); err != nil {
+		m.mu.Unlock()
+		return QuotaVerification{Passed: true, Reason: "persistence_failed"}
+	}
+	m.auths[next.ID] = next
+	m.mu.Unlock()
+	if m.scheduler != nil {
+		m.scheduler.upsertAuth(next.Clone())
+	}
+	models, epoch := registry.GetGlobalRegistry().GetModelsAndEpochForClient(next.ID)
+	projections := make([]registry.ClientModelProjection, 0, len(models))
+	for _, item := range models {
+		if item != nil {
+			projections = append(projections, m.clientModelProjectionForAuth(next, item.ID, now))
+		}
+	}
+	registry.GetGlobalRegistry().ApplyClientModelProjections(next.ID, epoch, next.Generation, projections)
+	return QuotaVerification{Passed: true, Restored: true, Reason: "restored"}
+}
