@@ -0,0 +1,29 @@
+// 管理侧单卡验证入口，固定最小提示词，不接受令牌、目标 URL 或额外请求头。
+package management
+
+import (
+	"net/http"
+
+	"github.com/gin-gonic/gin"
+)
+
+func (h *Handler) VerifyCodexQuota(c *gin.Context) {
+	var request struct {
+		Name             string `json:"name" binding:"required"`
+		AuthIndex        string `json:"auth_index" binding:"required"`
+		Model            string `json:"model" binding:"required,max=100"`
+		Recover          bool   `json:"recover"`
+		TokenFingerprint string `json:"token_fingerprint" binding:"required,len=64"`
+	}
+	if c.ShouldBindJSON(&request) != nil || h.authManager == nil {
+		c.JSON(http.StatusBadRequest, gin.H{"error": "invalid verification request"})
+		return
+	}
+	for _, a := range h.authManager.List() {
+		if a.FileName == request.Name && a.Index == request.AuthIndex && a.Provider == "codex" {
+			c.JSON(http.StatusOK, h.authManager.VerifyCodexQuota(c.Request.Context(), a.ID, request.Model, request.Recover, request.TokenFingerprint))
+			return
+		}
+	}
+	c.JSON(http.StatusConflict, gin.H{"error": "credential binding changed"})
+}
