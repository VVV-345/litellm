@@ -0,0 +1,277 @@
+// 用合成凭据验证临时访问证明、生命周期和持久化边界。
+package auth
+
+import (
+	"context"
+	"crypto/sha256"
+	"errors"
+	"fmt"
+	"strings"
+	"testing"
+	"time"
+)
+
+type fallbackExecutor struct{ quotaRecoveryExecutor }
+
+func (e *fallbackExecutor) Refresh(context.Context, *Auth) (*Auth, error) {
+	e.refreshes++
+	return nil, &Error{HTTPStatus: 401, Code: "unauthorized", Message: "synthetic refresh rejected"}
+}
+func fallbackFixture(t *testing.T) (*Manager, *fallbackExecutor, *Auth) {
+	t.Helper()
+	m := NewManager(nil, nil, nil)
+	e := &fallbackExecutor{}
+	m.RegisterExecutor(e)
+	m.cooldownStore = &recordingCooldownStateStore{}
+	a, err := m.Register(context.Background(), &Auth{ID: "quota-first", Provider: "codex", Status: StatusActive, Metadata: map[string]any{"access_token": "fixture-access", "refresh_token": "fixture-refresh", "expired": time.Now().Add(time.Hour).Format(time.RFC3339)}, ModelStates: map[string]*ModelState{}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, _ = m.RefreshAuth(context.Background(), a.ID)
+	a, _ = m.GetByID(a.ID)
+	return m, e, a
+}
+func fallbackVerify(t *testing.T, m *Manager) QuotaVerification {
+	t.Helper()
+	v, ok := any(m).(interface {
+		VerifyAccessTokenFallback(context.Context, string, string, string) QuotaVerification
+	})
+	if !ok {
+		t.Fatal("verified access-token fallback capability missing")
+	}
+	return v.VerifyAccessTokenFallback(context.Background(), "quota-first", "gpt-6-astra", fmt.Sprintf("%x", sha256.Sum256([]byte("fixture-access"))))
+}
+func TestAccessTokenFallbackRequiresCompleteBoundProof(t *testing.T) {
+	m, e, a := fallbackFixture(t)
+	if got := fallbackVerify(t, m); got.Restored || got.Passed {
+		t.Fatal("default-off accepted")
+	}
+	a.Metadata["codex_allow_valid_access_after_refresh_failure"] = true
+	if _, err := m.Update(context.Background(), a); err != nil {
+		t.Fatal(err)
+	}
+	current, _ := m.GetByID(a.ID)
+	if blocked, _, _ := isAuthBlockedForModel(current, "gpt-6-astra", time.Now()); !blocked {
+		t.Fatal("setting alone bypassed proof")
+	}
+	got := fallbackVerify(t, m)
+	if !got.Passed || !got.Restored || e.refreshes != 1 {
+		t.Fatalf("proof failed or refreshed: %+v / %d", got, e.refreshes)
+	}
+	current, _ = m.GetByID(a.ID)
+	if blocked, _, _ := isAuthBlockedForModel(current, "gpt-6-astra", time.Now()); blocked {
+		t.Fatal("verified model blocked")
+	}
+	if blocked, _, _ := isAuthBlockedForModel(current, "gpt-6-luna", time.Now()); !blocked {
+		t.Fatal("proof leaked to unverified model")
+	}
+	if m.shouldRefresh(current, time.Now().Add(2*time.Hour)) {
+		t.Fatal("rejected refresh scheduled")
+	}
+	for _, change := range []string{"expired", "proxy", "credential", "disabled", "off", "quota", "model"} {
+		t.Run(change, func(t *testing.T) {
+			next := current.Clone()
+			switch change {
+			case "expired":
+				next.Metadata["expired"] = time.Now().Add(-time.Second).Format(time.RFC3339)
+			case "proxy":
+				next.ProxyURL = "http://new-proxy.invalid"
+			case "credential":
+				next.Metadata["access_token"] = "replacement"
+			case "disabled":
+				next.Disabled = true
+			case "off":
+				next.Metadata["codex_allow_valid_access_after_refresh_failure"] = false
+			case "quota":
+				next.Quota = QuotaState{Exceeded: true, Reason: "credential_quota", NextRecoverAt: time.Now().Add(time.Hour)}
+			case "model":
+				next.ModelStates = map[string]*ModelState{"gpt-6-astra": {Status: StatusDisabled}}
+			}
+			if blocked, _, _ := isAuthBlockedForModel(next, "gpt-6-astra", time.Now()); !blocked {
+				t.Fatal("independent constraint bypassed")
+			}
+		})
+	}
+}
+func TestAccessTokenFallbackRejectsToolsAndIncomplete(t *testing.T) {
+	for _, payload := range []string{
+		"data: {\"type\":\"response.completed\",\"response\":{\"status\":\"completed\",\"output\":[{\"type\":\"function_call\"},{\"type\":\"message\",\"content\":[{\"type\":\"output_text\",\"text\":\"OK\"}]}]}}\n\n",
+		"data: {\"type\":\"response.incomplete\"}\n\n", "data: {\"type\":\"response.output_text.delta\",\"delta\":\"OK\"}\n\n", strings.Repeat("x", 512*1024+1),
+	} {
+		m, e, a := fallbackFixture(t)
+		a.Metadata["codex_allow_valid_access_after_refresh_failure"] = true
+		_, _ = m.Update(context.Background(), a)
+		e.payload = []byte(payload)
+		got := fallbackVerify(t, m)
+		if got.Passed || got.Restored || e.refreshes != 1 {
+			t.Fatalf("invalid proof accepted: %+v", got)
+		}
+	}
+}
+
+func TestAccessTokenFallbackInvalidationSurvivesRestart(t *testing.T) {
+	for _, change := range []string{"off", "disabled", "proxy"} {
+		t.Run(change, func(t *testing.T) {
+			m, _, a := fallbackFixture(t)
+			store := NewFileCooldownStateStore(t.TempDir())
+			m.cooldownStore = store
+			a.Metadata[accessFallbackSetting] = true
+			_, _ = m.Update(context.Background(), a)
+			if got := fallbackVerify(t, m); !got.Restored {
+				t.Fatalf("proof: %+v", got)
+			}
+			a, _ = m.GetByID(a.ID)
+			switch change {
+			case "off":
+				a.Metadata[accessFallbackSetting] = false
+			case "disabled":
+				a.Disabled = true
+			case "proxy":
+				a.ProxyURL = "http://fixture-proxy.invalid"
+			}
+			if _, err := m.Update(context.Background(), a); err != nil {
+				t.Fatal(err)
+			}
+			a, _ = m.GetByID(a.ID)
+			a.AccessFallback = nil
+			restarted := NewManager(nil, nil, nil)
+			restarted.cooldownStore = store
+			// Restore runtime state over the token-file view, then re-enable explicitly.
+			a.Disabled = false
+			a.Status = StatusActive
+			a.LastError = nil
+			a.Unavailable = false
+			a.Metadata[accessFallbackSetting] = true
+			a.ProxyURL = ""
+			if _, err := restarted.Register(context.Background(), a); err != nil {
+				t.Fatal(err)
+			}
+			if err := restarted.RestoreCooldownStates(context.Background()); err != nil {
+				t.Fatal(err)
+			}
+			current, _ := restarted.GetByID(a.ID)
+			if accessFallbackProven(current, "gpt-6-astra", time.Now()) {
+				t.Fatal("invalidated proof resurrected")
+			}
+		})
+	}
+}
+
+func TestAccessTokenFallbackRejectsIntermediateToolEvent(t *testing.T) {
+	m, e, a := fallbackFixture(t)
+	a.Metadata[accessFallbackSetting] = true
+	_, _ = m.Update(context.Background(), a)
+	e.payload = []byte("data: {\"type\":\"response.output_item.added\",\"item\":{\"type\":\"function_call\"}}\n\ndata: {\"type\":\"response.completed\",\"response\":{\"status\":\"completed\",\"output\":[{\"type\":\"message\",\"content\":[{\"type\":\"output_text\",\"text\":\"OK\"}]}]}}\n\n")
+	if got := fallbackVerify(t, m); got.Passed || got.Restored {
+		t.Fatalf("tool stream accepted: %+v", got)
+	}
+}
+
+func TestAccessTokenFallbackAllowsReasoningWithoutTools(t *testing.T) {
+	m, e, a := fallbackFixture(t)
+	a.Metadata[accessFallbackSetting] = true
+	_, _ = m.Update(context.Background(), a)
+	e.payload = []byte("data: {\"type\":\"response.completed\",\"response\":{\"status\":\"completed\",\"output\":[{\"type\":\"reasoning\",\"summary\":[]},{\"type\":\"message\",\"content\":[{\"type\":\"output_text\",\"text\":\"OK\"}]}]}}\n\n")
+	if got := fallbackVerify(t, m); !got.Passed || !got.Restored {
+		t.Fatalf("valid reasoning rejected: %+v", got)
+	}
+}
+
+func TestAccessTokenFallbackRejectsConcurrentStateChange(t *testing.T) {
+	for _, change := range []string{"disable", "credential", "proxy", "remove", "replace"} {
+		t.Run(change, func(t *testing.T) {
+			m, e, a := fallbackFixture(t)
+			a.Metadata[accessFallbackSetting] = true
+			_, _ = m.Update(context.Background(), a)
+			e.during = func() {
+				current, _ := m.GetByID(a.ID)
+				switch change {
+				case "disable":
+					current.Disabled = true
+				case "credential":
+					current.Metadata["access_token"] = "new-fixture"
+				case "proxy":
+					current.ProxyURL = "http://fixture.invalid"
+				case "remove":
+					m.Remove(context.Background(), a.ID)
+					return
+				case "replace":
+					m.Remove(context.Background(), a.ID)
+					current.AccessFallback = nil
+					_, _ = m.Register(context.Background(), current)
+				}
+				_, _ = m.Update(context.Background(), current)
+			}
+			if got := fallbackVerify(t, m); got.Restored {
+				t.Fatalf("stale proof committed: %+v", got)
+			}
+		})
+	}
+}
+
+type failFallbackStateSave struct{ CooldownStateStore }
+
+func (s failFallbackStateSave) Save(context.Context, []CooldownStateRecord) error {
+	return errors.New("fixture disk unavailable")
+}
+func TestAccessFallbackInvalidationSurvivesStateSaveFailure(t *testing.T) {
+	m, _, a := fallbackFixture(t)
+	store := NewFileCooldownStateStore(t.TempDir())
+	m.cooldownStore = store
+	a.Metadata[accessFallbackSetting] = true
+	_, _ = m.Update(context.Background(), a)
+	if got := fallbackVerify(t, m); !got.Restored {
+		t.Fatal(got)
+	}
+	m.cooldownStore = failFallbackStateSave{store}
+	for _, enabled := range []bool{false, true} {
