+// 本模块验证认证卷内身份的持久化、账号隔离和跨进程发布。
+package helps
+
+import (
+	"fmt"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"sync"
+	"testing"
+)
+
+func TestManagedIdentityHostAcrossProcesses(t *testing.T) {
+	if dir := os.Getenv("MANAGED_IDENTITY_FIXTURE_DIR"); dir != "" {
+		auth := &coreauth.Auth{ID: "process-fixture", Provider: "codex", Metadata: map[string]any{"access_token": "opaque", "account_id": "fixture-account"}}
+		bound, err := BindDurableManagedIdentity(dir, auth)
+		if err != nil {
+			t.Fatal(err)
+		}
+		fmt.Println("INSTALLATION=" + bound.Attributes[InstallationIDAttribute])
+		return
+	}
+	dir := t.TempDir()
+	installation := ""
+	for i := 0; i < 2; i++ {
+		command := exec.Command(os.Args[0], "-test.run=^TestManagedIdentityHostAcrossProcesses$")
+		command.Env = append(os.Environ(), "MANAGED_IDENTITY_FIXTURE_DIR="+dir)
+		output, err := command.CombinedOutput()
+		if err != nil {
+			t.Fatalf("child process: %v %s", err, output)
+		}
+		value := strings.Split(strings.TrimPrefix(string(output), "INSTALLATION="), "\n")[0]
+		if !strings.HasPrefix(string(output), "INSTALLATION=") || len(value) != 36 {
+			t.Fatalf("missing installation UUID: %s", output)
+		}
+		if i > 0 && value != installation {
+			t.Fatal("restart changed installation")
+		}
+		installation = value
+	}
+}
+
+func TestManagedIdentityHostAPIKeyScope(t *testing.T) {
+	dir := t.TempDir()
+	auth := &coreauth.Auth{ID: "api-fixture", Provider: "codex", Attributes: map[string]string{"api_key": "fixture-key-a", "base_url": "https://fixture.invalid"}}
+	first, err := BindDurableManagedIdentity(dir, auth)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, field := range []string{"api_key", "base_url"} {
+		changed := auth.Clone()
+		changed.Attributes[field] += "-changed"
+		bound, err := BindDurableManagedIdentity(dir, changed)
+		if err != nil || bound.Attributes[InstallationIDAttribute] == first.Attributes[InstallationIDAttribute] {
+			t.Fatalf("%s reused installation", field)
+		}
+	}
+}
+
+func TestManagedIdentityHostRejectsUnknownOAuthPrincipal(t *testing.T) {
+	auth := &coreauth.Auth{ID: "same-file", Provider: "codex", Metadata: map[string]any{"access_token": "opaque"}}
+	if _, err := BindDurableManagedIdentity(t.TempDir(), auth); err == nil {
+		t.Fatal("unknown OAuth principal must not share an installation after credentials change")
+	}
+}
+
+func TestManagedIdentityHostPersistenceIsolationAndCorruption(t *testing.T) {
+	dir := t.TempDir()
+	a := &coreauth.Auth{ID: "fixture", Provider: "codex", Metadata: map[string]any{"access_token": "opaque-fixture", "user_id": "user-fixture", "account_id": "account-fixture"}}
+	first, err := BindDurableManagedIdentity(dir, a)
+	if err != nil {
+		t.Fatal(err)
+	}
+	id := first.Attributes[InstallationIDAttribute]
+	if len(a.Attributes) != 0 {
+		t.Fatal("mutated shared auth")
+	}
+	refreshed := a.Clone()
+	refreshed.Metadata["access_token"] = "refreshed-fixture"
+	refreshed.ProxyURL = "http://localhost:9000"
+	second, err := BindDurableManagedIdentity(dir, refreshed)
+	if err != nil || second.Attributes[InstallationIDAttribute] != id {
+		t.Fatal("refresh changed installation")
+	}
+	var wg sync.WaitGroup
+	for i := 0; i < 16; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			got, e := BindDurableManagedIdentity(dir, a)
+			if e != nil || got.Attributes[InstallationIDAttribute] != id {
+				t.Error("concurrent identity changed")
+			}
+		}()
+	}
+	wg.Wait()
+	changed := a.Clone()
+	changed.Metadata["account_id"] = "other-fixture"
+	other, err := BindDurableManagedIdentity(dir, changed)
+	if err != nil || other.Attributes[InstallationIDAttribute] == id {
+		t.Fatal("principal scope reused")
+	}
+	files, err := filepath.Glob(filepath.Join(dir, ".codex-managed-identity", "*.json"))
+	if err != nil || len(files) != 2 {
+		t.Fatal("expected durable profiles")
+	}
+	for _, f := range files {
+		if err := os.WriteFile(f, []byte("bad"), 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if _, err := BindDurableManagedIdentity(dir, a); err == nil {
+		t.Fatal("corrupt profile accepted")
+	}
+}
