+func atomicTokenSave(path string, write func(string) error) error {
+	stage, err := os.CreateTemp(filepath.Dir(path), ".auth-save-*")
+	if err != nil {
+		return err
+	}
+	name := stage.Name()
+	defer func() { _ = os.Remove(name) }()
+	if err = stage.Close(); err != nil {
+		return err
+	}
+	if err = write(name); err != nil {
+		return err
+	}
+	file, err := os.OpenFile(name, os.O_RDWR, 0o600)
+	if err != nil {
+		return err
+	}
+	if err = file.Chmod(0o600); err != nil {
+		_ = file.Close()
+		return err
+	}
+	if err = file.Sync(); err != nil {
+		_ = file.Close()
+		return err
+	}
+	if err = file.Close(); err != nil {
+		return err
+	}
+	return os.Rename(name, path)
+}
