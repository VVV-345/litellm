+func TestCodexRefreshRetainsOmittedTokens(t *testing.T) {
+	a := &cliproxyauth.Auth{Metadata: map[string]any{"access_token": "old-access", "refresh_token": "old-refresh", "id_token": "old-id", "email": "fixture@example.invalid"}}
+	applyCodexRefreshTokens(a, &codexauth.CodexTokenData{AccessToken: "new-access", Expire: "2030-01-01T00:00:00Z"})
+	if a.Metadata["access_token"] != "new-access" || a.Metadata["refresh_token"] != "old-refresh" || a.Metadata["id_token"] != "old-id" || a.Metadata["email"] != "fixture@example.invalid" {
+		t.Fatal("omitted credential fields erased")
+	}
+	applyCodexRefreshTokens(a, &codexauth.CodexTokenData{AccessToken: "next-access", RefreshToken: "next-refresh", IDToken: "next-id"})
+	if a.Metadata["access_token"] != "next-access" || a.Metadata["refresh_token"] != "next-refresh" || a.Metadata["id_token"] != "next-id" {
+		t.Fatal("returned credential fields not applied")
+	}
+}
