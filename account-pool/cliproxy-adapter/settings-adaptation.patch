+func managedExecutorFixture() *coreauth.Auth {
+	return &coreauth.Auth{ID: "fixture", Provider: "codex", Metadata: map[string]any{"codex_fingerprint_mode": "managed", "access_token": "fixture-token", "account_id": "fixture-account", "user_id": "fixture-user"}}
+}
+func TestManagedPrepareRequestOutbound(t *testing.T) {
+	e := NewCodexExecutor(&config.Config{AuthDir: t.TempDir()})
+	a := managedExecutorFixture()
+	raw := `{"installation_id":"client","session_id":"keep","tools":[{"installation_id":"keep"}],"input":[{"encrypted_content":"opaque"}]}`
+	var observed string
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		data, _ := io.ReadAll(r.Body)
+		observed = r.Header.Get("X-Codex-Installation-Id")
+		if observed == "" || gjson.GetBytes(data, "installation_id").String() != observed {
+			t.Error("missing managed identity")
+		}
+		for _, path := range []string{"session_id", "tools", "input"} {
+			if gjson.GetBytes(data, path).Raw != gjson.Get(raw, path).Raw {
+				t.Error("changed opaque/session payload")
+			}
+		}
+		w.WriteHeader(204)
+	}))
+	defer server.Close()
+	request, _ := http.NewRequest("POST", server.URL+"/responses", strings.NewReader(raw))
+	request.Header.Set("Content-Type", "application/json")
+	request.Header.Set("Cookie", "caller-cookie")
+	if err := e.PrepareRequest(request, a); err != nil {
+		t.Fatal(err)
+	}
+	if request.Header.Get("Cookie") != "" {
+		t.Fatal("retained caller cookie")
+	}
+	response, err := http.DefaultClient.Do(request)
+	if err != nil {
+		t.Fatal(err)
+	}
+	response.Body.Close()
+	second, _ := http.NewRequest("POST", server.URL+"/responses", strings.NewReader(raw))
+	second.Header.Set("Content-Type", "application/json")
+	if err := e.PrepareRequest(second, a); err != nil {
+		t.Fatal(err)
+	}
+	if second.Header.Get("X-Codex-Installation-Id") != observed {
+		t.Fatal("identity not stable")
+	}
+	if a.Attributes[helps.InstallationIDAttribute] != "" {
+		t.Fatal("mutated shared auth")
+	}
+}
+func TestManagedCacheAndWebsocketOverrideConfuse(t *testing.T) {
+	e := NewCodexExecutor(&config.Config{AuthDir: t.TempDir(), Routing: config.RoutingConfig{SessionAffinity: true}, Codex: config.CodexConfig{IdentityConfuse: true}})
+	a, err := e.managedAuth(managedExecutorFixture())
+	if err != nil {
+		t.Fatal(err)
+	}
+	raw := []byte(`{"client_metadata":{"x-codex-installation-id":"client","session_id":"keep"},"input":[{"encrypted_content":"opaque"}]}`)
+	request, body, _, err := e.cacheHelper(context.Background(), sdktranslator.FormatOpenAIResponse, "http://localhost/responses", a, cliproxyexecutor.Request{Payload: raw}, raw, raw)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if gjson.GetBytes(body, "client_metadata.x-codex-installation-id").String() != a.Attributes[helps.InstallationIDAttribute] {
+		t.Fatal("confuse overrode managed installation")
+	}
+	if !bytes.Contains(body, []byte(`"encrypted_content":"opaque"`)) {
+		t.Fatal("opaque changed")
+	}
+	request.Header = applyCodexWebsocketHeaders(context.Background(), http.Header{}, a, "fixture-token", e.cfg)
+	_, err = helps.ApplyManagedIdentity(a, request.Header, body)
+	if err != nil || request.Header.Get("X-Codex-Installation-Id") != a.Attributes[helps.InstallationIDAttribute] {
+		t.Fatal("websocket installation missing")
+	}
+}
+
+func TestManagedIdentityRealHTTPAndWebsocketPaths(t *testing.T) {
+	for _, protocol := range []string{"http", "sse", "compact", "ws", "ws-stream"} {
+		for _, confuse := range []bool{false, true} {
+			t.Run(protocol+"/confuse="+fmt.Sprint(confuse), func(t *testing.T) {
+				type captured struct {
+					header http.Header
+					body   []byte
+				}
+				observed := make(chan captured, 1)
+				completed := []byte(`{"type":"response.completed","response":{"id":"fixture-response","output":[],"usage":{"input_tokens":1,"output_tokens":1,"total_tokens":2}}}`)
+				server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+					if strings.HasPrefix(protocol, "ws") {
+						upgrader := websocket.Upgrader{CheckOrigin: func(*http.Request) bool { return true }}
+						conn, err := upgrader.Upgrade(w, r, nil)
+						if err != nil {
+							t.Error(err)
+							return
+						}
+						defer conn.Close()
+						_, body, err := conn.ReadMessage()
+						if err != nil {
+							t.Error(err)
+							return
+						}
+						observed <- captured{r.Header.Clone(), body}
+						if err := conn.WriteMessage(websocket.TextMessage, completed); err != nil {
+							t.Error(err)
+						}
+					} else {
+						body, err := io.ReadAll(r.Body)
+						if err != nil {
+							t.Error(err)
+							return
+						}
+						observed <- captured{r.Header.Clone(), body}
+						if protocol == "compact" {
+							w.Header().Set("Content-Type", "application/json")
+							_, _ = w.Write([]byte(`{"id":"fixture-response","output":[]}`))
+						} else {
+							w.Header().Set("Content-Type", "text/event-stream")
+							_, _ = w.Write(append(append([]byte("data: "), completed...), []byte("\n\n")...))
+						}
+					}
+				}))
+				defer server.Close()
+				cfg := &config.Config{AuthDir: t.TempDir(), Routing: config.RoutingConfig{SessionAffinity: true}, Codex: config.CodexConfig{IdentityConfuse: confuse}}
+				cfg.DisableImageGeneration = config.DisableImageGenerationAll
+				auth := managedExecutorFixture()
+				auth.Attributes = map[string]string{"base_url": server.URL}
+				encrypted := validOpenAIResponsesReasoningEncryptedContentForTest()
+				raw := []byte(`{"model":"fixture-model","prompt_cache_key":"fixture-cache","client_metadata":{"x-codex-installation-id":"caller","session_id":"keep"},"input":[{"type":"reasoning","id":"rs_fixture","summary":[],"encrypted_content":"` + encrypted + `"},{"role":"user","content":"hello"}]}`)
+				req := cliproxyexecutor.Request{Model: "fixture-model", Payload: raw}
+				opts := cliproxyexecutor.Options{SourceFormat: sdktranslator.FromString("codex"), Headers: http.Header{"Cookie": {"caller"}}}
+				ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+				defer cancel()
+				httpExec := NewCodexExecutor(cfg)
+				wsExec := NewCodexWebsocketsExecutor(cfg)
+				var err error
+				switch protocol {
+				case "http":
+					_, err = httpExec.Execute(ctx, auth, req, opts)
+				case "compact":
+					opts.Alt = "responses/compact"
+					_, err = httpExec.Execute(ctx, auth, req, opts)
+				case "ws":
+					_, err = wsExec.Execute(ctx, auth, req, opts)
+				default:
+					var result *cliproxyexecutor.StreamResult
+					if protocol == "sse" {
+						result, err = httpExec.ExecuteStream(ctx, auth, req, opts)
+					} else {
+						result, err = wsExec.ExecuteStream(ctx, auth, req, opts)
+					}
+					if err == nil {
+						for chunk := range result.Chunks {
+							if chunk.Err != nil {
+								err = chunk.Err
+							}
+						}
+					}
+				}
+				if err != nil {
+					t.Fatal(err)
+				}
+				select {
+				case got := <-observed:
+					bound, err := httpExec.managedAuth(auth)
+					if err != nil {
+						t.Fatal(err)
+					}
+					installation := bound.Attributes[helps.InstallationIDAttribute]
+					if got.header.Get("X-Codex-Installation-Id") != installation || gjson.GetBytes(got.body, "client_metadata.x-codex-installation-id").String() != installation {
+						t.Fatal("request installation differs from durable account identity")
+					}
+					if got.header.Get("Cookie") != "" {
+						t.Fatal("caller cookie leaked")
+					}
+					wantCache := "fixture-cache"
+					if confuse {
+						wantCache = codexIdentityConfuseUUID(auth.ID, "prompt-cache", wantCache)
+					}
+					if gjson.GetBytes(got.body, "prompt_cache_key").String() != wantCache {
+						t.Fatal("cache mapping does not match explicit confusion setting")
+					}
+					if gjson.GetBytes(got.body, "client_metadata.session_id").String() != "keep" || gjson.GetBytes(got.body, "input.0.encrypted_content").String() != encrypted {
+						t.Fatal("managed identity changed conversation or encrypted history")
+					}
+				case <-ctx.Done():
+					t.Fatal("upstream request not observed")
+				}
+			})
+		}
+	}
+}
