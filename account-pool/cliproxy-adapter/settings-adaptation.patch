+// 单卡恢复测试只使用模拟执行器，确认失败无副作用且成功不触碰其他凭据。
+package auth
+
+import (
+	"context"
+	"crypto/sha256"
+	"errors"
+	"fmt"
+	"reflect"
+	"strings"
+	"testing"
+	"time"
+
+	exec "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/executor"
+)
+
+type quotaRecoveryExecutor struct {
+	compactTestExecutor
+	failure   error
+	during    func()
+	refreshes int
+	payload   []byte
+}
+
+func (e *quotaRecoveryExecutor) Identifier() string { return "codex" }
+func (e *quotaRecoveryExecutor) Refresh(_ context.Context, a *Auth) (*Auth, error) {
+	e.refreshes++
+	return a, nil
+}
+func (e *quotaRecoveryExecutor) ExecuteStream(_ context.Context, a *Auth, r exec.Request, o exec.Options) (*exec.StreamResult, error) {
+	e.calls++
+	if a.ID != "quota-first" || r.Model != "gpt-6-astra" || o.SourceFormat.String() != "openai-response" {
+		return nil, errors.New("wrong binding")
+	}
+	if e.during != nil {
+		e.during()
+	}
+	if e.failure != nil {
+		return nil, e.failure
+	}
+	chunks := make(chan exec.StreamChunk, 1)
+	payload := e.payload
+	if payload == nil {
+		payload = []byte("data: {\"type\":\"response.completed\",\"response\":{\"status\":\"completed\",\"output\":[{\"type\":\"message\",\"content\":[{\"type\":\"output_text\",\"text\":\"OK\"}]}]}}\n\n")
+	}
+	chunks <- exec.StreamChunk{Payload: payload}
+	close(chunks)
+	return &exec.StreamResult{Chunks: chunks}, nil
+}
+
+func TestQuotaRecoveryPreservesUnknown429AndModelQuotaReasons(t *testing.T) {
+	for _, mode := range []string{"overload", "model-quota", "model-wait"} {
+		t.Run(mode, func(t *testing.T) {
+			m, _ := quotaRecoveryFixture(t)
+			a := m.auths["quota-first"]
+			switch mode {
+			case "overload":
+				a.LastError = &Error{HTTPStatus: 429, Code: "server_is_overloaded"}
+			case "model-quota":
+				a.ModelStates["gpt-6-astra"].Quota = QuotaState{Exceeded: true, Reason: "independent_throttle"}
+			case "model-wait":
+				a.ModelStates["gpt-6-astra"].LastError = nil
+			}
+			before := a.Clone()
+			result := m.VerifyCodexQuota(context.Background(), a.ID, "gpt-6-astra", true)
+			after, _ := m.GetByID(a.ID)
+			if result.Restored || result.Reason != "independent_block" || !reflect.DeepEqual(before, after) {
+				t.Fatalf("independent block removed: %+v", result)
+			}
+		})
+	}
+}
+
+func TestQuotaRecoveryInvalidStreamNeverChangesState(t *testing.T) {
+	for _, payload := range []string{"", "data: {\"type\":\"response.incomplete\"}\n\n", "data: {\"type\":\"response.completed\",\"response\":{\"status\":\"completed\",\"output\":[]}}\n\n", strings.Repeat("x", 512*1024+1)} {
+		m, e := quotaRecoveryFixture(t)
+		e.payload = []byte(payload)
+		before, _ := m.GetByID("quota-first")
+		result := m.VerifyCodexQuota(context.Background(), before.ID, "gpt-6-astra", true)
+		after, _ := m.GetByID(before.ID)
+		if result.Passed || result.Restored || e.refreshes != 0 || !reflect.DeepEqual(before, after) {
+			t.Fatalf("invalid stream accepted: %+v", result)
+		}
+	}
+}
+
+type failedQuotaRecoveryStore struct{ recordingCooldownStateStore }
+
+func (*failedQuotaRecoveryStore) Save(context.Context, []CooldownStateRecord) error {
+	return errors.New("fixture persistence failure")
+}
+
+func TestQuotaRecoveryPersistenceFailureAndFingerprint(t *testing.T) {
+	m, e := quotaRecoveryFixture(t)
+	before, _ := m.GetByID("quota-first")
+	m.cooldownStore = &failedQuotaRecoveryStore{}
+	bad := m.VerifyCodexQuota(context.Background(), before.ID, "gpt-6-astra", true, strings.Repeat("0", 64))
+	if bad.Reason != "credential_changed" || e.calls != 0 {
+		t.Fatalf("wrong fingerprint dispatched: %+v", bad)
+	}
+	result := m.VerifyCodexQuota(context.Background(), before.ID, "gpt-6-astra", true, fmt.Sprintf("%x", sha256.Sum256([]byte("fixture-access"))))
+	after, _ := m.GetByID(before.ID)
+	if !result.Passed || result.Restored || result.Reason != "persistence_failed" || !reflect.DeepEqual(before, after) {
+		t.Fatalf("persistence failure exposed recovered state: %+v", result)
+	}
+}
+
+func TestQuotaRecoveryFailureNeverRefreshesOrChangesState(t *testing.T) {
+	m, e := quotaRecoveryFixture(t)
+	before, _ := m.GetByID("quota-first")
+	e.failure = compactTestStatusError{code: 401, msg: "unauthorized"}
+	result := m.VerifyCodexQuota(context.Background(), "quota-first", "gpt-6-astra", true)
+	after, _ := m.GetByID("quota-first")
+	if result.Passed || result.Restored || result.Reason != "authentication_failed" || e.refreshes != 0 || !reflect.DeepEqual(before, after) {
+		t.Fatalf("unexpected result: %+v", result)
+	}
+}
+
+func TestQuotaRecoverySuccessClearsOnlyProvenStateWithoutTokenWrites(t *testing.T) {
+	m, e := quotaRecoveryFixture(t)
+	second, _ := m.GetByID("quota-second")
+	result := m.VerifyCodexQuota(context.Background(), "quota-first", "gpt-6-astra", true)
+	first, _ := m.GetByID("quota-first")
+	afterSecond, _ := m.GetByID("quota-second")
+	if !result.Passed || !result.Restored || first.Unavailable || first.StatusMessage != "" || e.refreshes != 0 {
+		t.Fatalf("unexpected result: %+v, %+v", result, first)
+	}
+	if first.Metadata["access_token"] != "fixture-access" || !reflect.DeepEqual(second, afterSecond) || !first.ModelStates["gpt-6-luna"].Unavailable {
+		t.Fatal("unrelated state changed")
+	}
+}
+
+func TestQuotaRecoveryProbeOnlyAndConcurrentChangeNeverRestore(t *testing.T) {
+	for _, mode := range []string{"probe", "disabled", "race"} {
+		t.Run(mode, func(t *testing.T) {
+			m, e := quotaRecoveryFixture(t)
+			if mode == "disabled" {
+				m.mu.Lock()
+				m.auths["quota-first"].Disabled = true
+				m.mu.Unlock()
+			}
+			if mode == "race" {
+				e.during = func() { m.mu.Lock(); m.auths["quota-first"].Generation++; m.mu.Unlock() }
+			}
+			result := m.VerifyCodexQuota(context.Background(), "quota-first", "gpt-6-astra", mode != "probe")
+			first, _ := m.GetByID("quota-first")
+			if result.Restored || first.StatusMessage != "unauthorized" || (mode == "disabled" && e.calls != 0) {
+				t.Fatalf("state was bypassed: %+v", result)
+			}
+		})
+	}
+}
+
+func quotaRecoveryFixture(t *testing.T) (*Manager, *quotaRecoveryExecutor) {
+	t.Helper()
+	m := NewManager(nil, nil, nil)
+	e := &quotaRecoveryExecutor{}
+	m.RegisterExecutor(e)
+	m.cooldownStore = &recordingCooldownStateStore{}
+	for _, id := range []string{"quota-first", "quota-second"} {
+		_, err := m.Register(context.Background(), &Auth{ID: id, Provider: "codex", Status: StatusError, StatusMessage: "unauthorized", Unavailable: true, LastError: &Error{HTTPStatus: 401, Code: "unauthorized"}, Metadata: map[string]any{"access_token": "fixture-access", "refresh_token": "fixture-refresh"}, ModelStates: map[string]*ModelState{
+			"gpt-6-astra": {Status: StatusError, Unavailable: true, NextRetryAfter: time.Now().Add(time.Hour), LastError: &Error{HTTPStatus: 401}},
+			"gpt-6-luna":  {Status: StatusError, Unavailable: true, NextRetryAfter: time.Now().Add(time.Hour), LastError: &Error{HTTPStatus: 429}},
+		}})
+		if err != nil {
+			t.Fatal(err)
+		}
+	}
+	return m, e
+}
