--- /dev/null
+++ b/internal/api/handlers/management/credential_refresh.go
@@ -0,0 +1,51 @@
+// 通过受保护管理入口刷新绑定凭据，只返回安全结果分类。
+package management
+
+import (
+	"errors"
+	"github.com/gin-gonic/gin"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+	"net/http"
+)
+
+func (h *Handler) RefreshCodexCredential(c *gin.Context) {
+	var request struct {
+		Name             string `json:"name" binding:"required"`
+		AuthIndex        string `json:"auth_index" binding:"required"`
+		TokenFingerprint string `json:"token_fingerprint" binding:"required,len=64"`
+	}
+	if c.ShouldBindJSON(&request) != nil || h.authManager == nil {
+		c.JSON(http.StatusBadRequest, gin.H{"error": "invalid refresh request"})
+		return
+	}
+	for _, a := range h.authManager.List() {
+		if a.Provider != "codex" || !matchesAuthFileLookup(a, request.Name, request.AuthIndex) {
+			continue
+		}
+		_, err := h.authManager.RefreshCredential(c.Request.Context(), a.ID, request.TokenFingerprint)
+		status := h.authManager.CredentialRefreshStatus(a.ID)
+		reason := "saved"
+		switch {
+		case err == nil:
+		case status.LastResult == "unknown_outcome":
+			reason = "refresh_outcome_unknown"
+		case errors.Is(err, coreauth.ErrRefreshJournal):
+			reason = "persistence_unavailable"
+		case errors.Is(err, coreauth.ErrRefreshPersistence):
+			reason = "save_pending"
+		case errors.Is(err, coreauth.ErrRefreshRejected):
+			reason = "reauthorization_required"
+		case errors.Is(err, coreauth.ErrRefreshStale):
+			reason = "state_changed"
+		case errors.Is(err, coreauth.ErrRefreshBackoff):
+			reason = "backoff"
+		case status.LastResult == "rejected":
+			reason = "reauthorization_required"
+		default:
+			reason = "refresh_failed"
+		}
+		c.JSON(http.StatusOK, gin.H{"saved": err == nil, "reason": reason, "status": status})
+		return
+	}
+	c.JSON(http.StatusConflict, gin.H{"error": "credential binding changed"})
+}
