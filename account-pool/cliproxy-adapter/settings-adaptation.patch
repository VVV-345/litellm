+func TestCodexManagementBindingMatchesAuthFileLookup(t *testing.T) {
+	for _, endpoint := range []string{"fallback", "quota", "refresh"} {
+		for _, test := range []struct {
+			name     string
+			fileName string
+			provider string
+			change   string
+			wantHTTP int
+		}{
+			{name: "file-loaded-ID", provider: "codex", wantHTTP: 200},
+			{name: "uploaded-file-name", fileName: "uploaded.json", provider: "codex", wantHTTP: 200},
+			{name: "existing-ID-alias", fileName: "uploaded.json", provider: "codex", change: "ID-alias", wantHTTP: 200},
+			{name: "wrong-name", provider: "codex", change: "wrong-name", wantHTTP: 409},
+			{name: "other-credential-index", provider: "codex", change: "other-index", wantHTTP: 409},
+			{name: "wrong-provider", provider: "claude", wantHTTP: 409},
+			{name: "missing-name", provider: "codex", change: "missing-name", wantHTTP: 400},
+			{name: "missing-index", provider: "codex", change: "missing-index", wantHTTP: 400},
+			{name: "invalid-fingerprint", provider: "codex", change: "invalid-fingerprint", wantHTTP: 400},
+		} {
+			t.Run(endpoint+"/"+test.name, func(t *testing.T) {
+				manager := auth.NewManager(nil, nil, nil)
+				entry, err := manager.Register(context.Background(), &auth.Auth{ID: "fixture.json", FileName: test.fileName, Provider: test.provider, Status: auth.StatusActive, Attributes: map[string]string{"path": filepath.Join(t.TempDir(), "fixture.json")}, Metadata: map[string]any{"access_token": "fixture-access"}})
+				if err != nil {
+					t.Fatal(err)
+				}
+				other, err := manager.Register(context.Background(), &auth.Auth{ID: "other.json", Provider: "codex", Status: auth.StatusActive})
+				if err != nil {
+					t.Fatal(err)
+				}
+				handler := &Handler{cfg: &config.Config{}, authManager: manager}
+				listed := handler.buildAuthFileEntry(entry)
+				body := map[string]any{"name": listed["name"], "auth_index": listed["auth_index"], "model": "gpt-6-astra", "token_fingerprint": fmt.Sprintf("%064d", 0)}
+				switch test.change {
+				case "ID-alias":
+					body["name"] = entry.ID
+				case "wrong-name":
+					body["name"] = other.ID
+				case "other-index":
+					body["auth_index"] = other.Index
+				case "missing-name":
+					delete(body, "name")
+				case "missing-index":
+					delete(body, "auth_index")
+				case "invalid-fingerprint":
+					body["token_fingerprint"] = "invalid"
+				}
+				if endpoint == "refresh" {
+					delete(body, "model")
+				}
+				payload, err := json.Marshal(body)
+				if err != nil {
+					t.Fatal(err)
+				}
+				router := gin.New()
+				router.POST("/fallback", handler.VerifyAccessTokenFallback)
+				router.POST("/quota", handler.VerifyCodexQuota)
+				router.POST("/refresh", handler.RefreshCodexCredential)
+				response := httptest.NewRecorder()
+				request := httptest.NewRequest(http.MethodPost, "/"+endpoint, bytes.NewReader(payload))
+				request.Header.Set("Content-Type", "application/json")
+				router.ServeHTTP(response, request)
+				if response.Code != test.wantHTTP {
+					t.Fatalf("HTTP %d, want %d: %s", response.Code, test.wantHTTP, response.Body.String())
+				}
+				if test.wantHTTP == 200 {
+					var result struct {
+						Passed   bool `json:"passed"`
+						Restored bool `json:"restored"`
+						Saved    bool `json:"saved"`
+					}
+					if err := json.Unmarshal(response.Body.Bytes(), &result); err != nil || result.Passed || result.Restored || result.Saved {
+						t.Fatal("binding lookup bypassed verification eligibility or fingerprint checks")
+					}
+				}
+			})
+		}
+	}
+}
