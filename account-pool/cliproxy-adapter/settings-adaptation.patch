diff --git a/sdk/cliproxy/auth/access_token_fallback.go b/sdk/cliproxy/auth/access_token_fallback.go
new file mode 100644
index 0000000000000000000000000000000000000000..51a21de14aa16c19bc3e9a24f16069b439119236
--- /dev/null
+++ b/sdk/cliproxy/auth/access_token_fallback.go
@@ -0,0 +1,245 @@
+// 仅允许经过完整推理验证的现有访问令牌降级，不解除独立额度和人工限制。
+package auth
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/json"
+	"fmt"
+	"reflect"
+	"sort"
+	"strings"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/registry"
+)
+
+const accessFallbackSetting = "codex_allow_valid_access_after_refresh_failure"
+const accessFallbackVersion = "codex_access_fallback_version"
+
+type AccessFallbackState struct {
+	ConfigVersion   string    `json:"config_version,omitempty"`
+	Credential      string    `json:"credential"`
+	Proxy           string    `json:"proxy"`
+	FailedAt        time.Time `json:"failed_at"`
+	RefreshError    *Error    `json:"refresh_error,omitempty"`
+	RefreshRejected bool      `json:"refresh_rejected"`
+	AccessRejected  bool      `json:"access_rejected"`
+	ExpiresAt       time.Time `json:"expires_at"`
+	Models          []string  `json:"models,omitempty"`
+}
+
+func (s *AccessFallbackState) Clone() *AccessFallbackState {
+	if s == nil {
+		return nil
+	}
+	c := *s
+	c.RefreshError = cloneError(s.RefreshError)
+	c.Models = append([]string(nil), s.Models...)
+	return &c
+}
+
+type AccessFallbackView struct {
+	Enabled        bool       `json:"enabled"`
+	Active         bool       `json:"active"`
+	Reason         string     `json:"reason"`
+	ExpiresAt      *time.Time `json:"expires_at"`
+	VerifiedModels []string   `json:"verified_models"`
+	FailureSource  string     `json:"failure_source,omitempty"`
+}
+
+func initializeAccessOnlyFallback(a *Auth, now time.Time) bool {
+	if _, managed := a.Metadata[accessFallbackSetting]; !managed {
+		return false
+	}
+	if a.Provider != "codex" || authAccessToken(a) == "" || authHasRefreshCredential(a) || accessFallbackBound(a) {
+		return false
+	}
+	a.AccessFallback = &AccessFallbackState{Credential: refreshCredentialFingerprint(a), Proxy: accessFallbackProxy(a), FailedAt: now, RefreshRejected: true}
+	return true
+}
+
+func accessFallbackEnabled(a *Auth) bool { v, _ := a.Metadata[accessFallbackSetting].(bool); return v }
+func accessFallbackBound(a *Auth) bool {
+	return a != nil && a.AccessFallback != nil && a.AccessFallback.Credential == refreshCredentialFingerprint(a)
+}
+func accessFallbackProxy(a *Auth) string { return fmt.Sprintf("%x", sha256.Sum256([]byte(a.ProxyURL))) }
+func accessFallbackExpiry(a *Auth) time.Time {
+	expiry, _ := a.ExpirationTime()
+	parts := strings.Split(authAccessToken(a), ".")
+	if len(parts) == 3 {
+		raw, err := base64.RawURLEncoding.DecodeString(parts[1])
+		var claims struct {
+			Exp int64 `json:"exp"`
+		}
+		if err == nil && json.Unmarshal(raw, &claims) == nil && claims.Exp > 0 {
+			claimed := time.Unix(claims.Exp, 0)
+			if expiry.IsZero() || claimed.Before(expiry) {
+				expiry = claimed
+			}
+		}
+	}
+	return expiry
+}
+func accessFallbackProven(a *Auth, model string, now time.Time) bool {
+	if !accessFallbackBound(a) || !accessFallbackEnabled(a) || a.AccessFallback.AccessRejected || a.AccessFallback.Proxy != accessFallbackProxy(a) || a.AccessFallback.ConfigVersion != authMetadataString(a, accessFallbackVersion) {
+		return false
+	}
+	expiry := accessFallbackExpiry(a)
+	if expiry.IsZero() || !expiry.After(now) || !a.AccessFallback.ExpiresAt.After(now) {
+		return false
+	}
+	for _, verified := range a.AccessFallback.Models {
+		if canonicalModelKey(model) == verified {
+			return true
+		}
+	}
+	return false
+}
+func withoutRefreshFailure(a *Auth) *Auth {
+	next := a.Clone()
+	next.AccessFallback = nil
+	if next.LastError != nil && a.AccessFallback != nil && reflect.DeepEqual(next.LastError, a.AccessFallback.RefreshError) && !a.AccessFallback.AccessRejected {
+		next.LastError = nil
+		next.StatusMessage = ""
+		next.Unavailable = false
+		if next.Status == StatusError {
+			next.Status = StatusActive
+		}
+	}
+	return next
+}
+func AccessTokenFallbackStatus(a *Auth, now time.Time) AccessFallbackView {
+	view := AccessFallbackView{VerifiedModels: []string{}, Reason: "not_needed"}
+	if a == nil {
+		return view
+	}
+	view.Enabled = accessFallbackEnabled(a)
+	expiry := accessFallbackExpiry(a)
+	if !expiry.IsZero() {
+		view.ExpiresAt = &expiry
+	}
+	if !accessFallbackBound(a) {
+		return view
+	}
+	view.FailureSource = "refresh"
+	view.Reason = "verification_required"
+	if !view.Enabled {
+		view.Reason = "disabled"
+		return view
+	}
+	if a.AccessFallback.AccessRejected {
+		view.Reason = "access_rejected"
+		return view
+	}
+	if expiry.IsZero() || !expiry.After(now) {
+		view.Reason = "access_expired"
+		return view
+	}
+	for _, model := range a.AccessFallback.Models {
+		if accessFallbackProven(a, model, now) {
+			if blocked, _, _ := isAuthBlockedForModel(withoutRefreshFailure(a), model, now); !blocked {
+				view.VerifiedModels = append(view.VerifiedModels, model)
+			}
+		}
+	}
+	sort.Strings(view.VerifiedModels)
+	view.Active = len(view.VerifiedModels) > 0
+	if view.Active {
+		view.Reason = "temporary_access"
+	}
+	return view
+}
+func (m *Manager) VerifyAccessTokenFallback(ctx context.Context, id, model, fingerprint string) QuotaVerification {
+	before, ok := m.GetByID(id)
+	if !ok || before.Provider != "codex" || !accessFallbackEnabled(before) || !accessFallbackBound(before) || before.AccessFallback.AccessRejected {
+		return QuotaVerification{Reason: "not_eligible"}
+	}
+	expiry := accessFallbackExpiry(before)
+	if expiry.IsZero() || !expiry.After(time.Now()) {
+		return QuotaVerification{Reason: "access_expired"}
+	}
+	if blocked, _, _ := isAuthBlockedForModel(withoutRefreshFailure(before), model, time.Now()); blocked {
+		return QuotaVerification{Reason: "independent_block"}
+	}
+	result := m.VerifyCodexQuota(ctx, id, model, false, fingerprint)
+	if !result.Passed {
+		if result.Reason == "authentication_failed" {
+			m.rejectFallbackAccess(ctx, before)
+		}
+		return result
+	}
+	lock := m.authRefreshLock(id)
+	lock.commitMu.Lock()
+	defer lock.commitMu.Unlock()
+	m.configCooldownMu.Lock()
+	defer m.configCooldownMu.Unlock()
+	m.mu.Lock()
+	current := m.auths[id]
+	if current == nil || current.Generation != before.Generation || current.RegistrationEpoch != before.RegistrationEpoch || !sameRefreshCredential(current, before) || current.ProxyURL != before.ProxyURL || !reflect.DeepEqual(current.Metadata, before.Metadata) {
+		m.mu.Unlock()
+		return QuotaVerification{Passed: true, Reason: "state_changed"}
+	}
+	if m.cooldownStore == nil {
+		m.mu.Unlock()
+		return QuotaVerification{Passed: true, Reason: "persistence_unavailable"}
+	}
+	next := current.Clone()
+	next.AccessFallback.Proxy = accessFallbackProxy(next)
+	next.AccessFallback.ExpiresAt = expiry
+	next.AccessFallback.ConfigVersion = authMetadataString(next, accessFallbackVersion)
+	key := canonicalModelKey(model)
+	found := false
+	for _, v := range next.AccessFallback.Models {
+		found = found || v == key
+	}
+	if !found {
+		next.AccessFallback.Models = append(next.AccessFallback.Models, key)
+	}
+	next.Generation++
+	next.UpdatedAt = time.Now()
+	records := []CooldownStateRecord{}
+	for authID, a := range m.auths {
+		if authID == id {
+			a = next
+		}
+		records = append(records, m.cooldownStateRecordsForAuthLocked(a, time.Now())...)
+	}
+	if err := m.cooldownStore.Save(ctx, records); err != nil {
+		m.mu.Unlock()
+		return QuotaVerification{Passed: true, Reason: "persistence_failed"}
+	}
+	m.auths[id] = next
+	m.mu.Unlock()
+	m.refreshFallbackProjection(next)
+	return QuotaVerification{Passed: true, Restored: true, Reason: "temporary_access", ExpiresAt: &expiry}
+}
+func (m *Manager) refreshFallbackProjection(a *Auth) {
+	if m.scheduler != nil {
+		m.scheduler.upsertAuth(a.Clone())
+	}
+	models, epoch := registry.GetGlobalRegistry().GetModelsAndEpochForClient(a.ID)
+	projections := make([]registry.ClientModelProjection, 0, len(models))
+	for _, model := range models {
+		if model != nil {
+			projections = append(projections, m.clientModelProjectionForAuth(a, model.ID, time.Now()))
+		}
+	}
+	registry.GetGlobalRegistry().ApplyClientModelProjections(a.ID, epoch, a.Generation, projections)
+}
+func (m *Manager) rejectFallbackAccess(ctx context.Context, before *Auth) {
+	m.mu.Lock()
+	current := m.auths[before.ID]
+	if current == nil || !sameRefreshCredential(current, before) || !accessFallbackBound(current) {
+		m.mu.Unlock()
+		return
+	}
+	current.AccessFallback = current.AccessFallback.Clone()
+	current.AccessFallback.AccessRejected = true
+	current.Generation++
+	next := current.Clone()
+	m.mu.Unlock()
+	m.persistCooldownStates(context.WithoutCancel(ctx))
+	m.refreshFallbackProjection(next)
+}
