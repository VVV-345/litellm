+
+type refreshPersistenceStore struct {
+	fail   bool
+	stored *Auth
+}
+
+func (s *refreshPersistenceStore) List(context.Context) ([]*Auth, error) { return nil, nil }
+func (s *refreshPersistenceStore) Delete(context.Context, string) error  { return nil }
+func (s *refreshPersistenceStore) Save(ctx context.Context, a *Auth) (string, error) {
+	if ctx.Err() != nil {
+		return "", ctx.Err()
+	}
+	if s.fail {
+		return "", errors.New("synthetic secret must not appear")
+	}
+	s.stored = a.Clone()
+	return a.ID, nil
+}
+
+type refreshPersistenceExecutor struct {
+	ProviderExecutor
+	calls   int
+	during  func()
+	failure error
+}
+
+func (e *refreshPersistenceExecutor) Identifier() string { return "synthetic-refresh" }
+func (e *refreshPersistenceExecutor) Refresh(ctx context.Context, a *Auth) (*Auth, error) {
+	e.calls++
+	if e.during != nil {
+		e.during()
+	}
+	if e.failure != nil {
+		return nil, e.failure
+	}
+	a.Metadata["access_token"] = "synthetic-new-access"
+	a.Metadata["refresh_token"] = "synthetic-new-refresh"
+	a.Metadata["expired"] = time.Now().Add(time.Hour).Format(time.RFC3339)
+	return a, nil
+}
+func newRefreshPersistenceFixture(t *testing.T) (*Manager, *refreshPersistenceStore, *refreshPersistenceExecutor, *Auth) {
+	t.Helper()
+	setRefreshLeadFactory(t, "synthetic-refresh", func() *time.Duration { lead := 10 * time.Minute; return &lead })
+	store := &refreshPersistenceStore{}
+	exec := &refreshPersistenceExecutor{}
+	manager := NewManager(store, nil, nil)
+	manager.RegisterExecutor(exec)
+	a, err := manager.Register(context.Background(), &Auth{ID: "synthetic-auth", Provider: exec.Identifier(), Status: StatusActive, Metadata: map[string]any{"access_token": "synthetic-old-access", "refresh_token": "synthetic-old-refresh"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return manager, store, exec, a
+}
+func TestRefreshPersistenceRetriesSaveOnly(t *testing.T) {
+	m, s, e, a := newRefreshPersistenceFixture(t)
+	s.fail = true
+	rotated, err := m.RefreshAuth(context.Background(), a.ID)
+	if err == nil {
+		t.Error("save failure hidden")
+	}
+	if err != nil && err.Error() != "refreshed credentials retained in memory; persistence pending" {
+		t.Errorf("unsafe/unclassified storage error: %v", err)
+	}
+	current, _ := m.GetByID(a.ID)
+	if rotated == nil || current.Metadata["refresh_token"] != "synthetic-new-refresh" {
+		t.Fatal("rotated pair lost")
+	}
+	if hasUnauthorizedAuthFailure(current) {
+		t.Fatal("storage failure marked unauthorized")
+	}
+	now := time.Now().Add(2 * refreshFailureBackoff)
+	if !m.shouldRefresh(current, now) {
+		t.Error("pending save not due")
+	}
+	next, scheduled := nextRefreshCheckAt(now, current, time.Second)
+	if !scheduled || next.After(now) {
+		t.Error("pending save unscheduled")
+	}
+	s.fail = false
+	if _, err = m.RefreshAuth(context.Background(), a.ID); err != nil {
+		t.Fatal(err)
+	}
+	if e.calls != 1 {
+		t.Errorf("OAuth refresh repeated: %d", e.calls)
+	}
+	if s.stored.Metadata["refresh_token"] != "synthetic-new-refresh" {
+		t.Error("latest pair not saved")
+	}
+}
+func TestRefreshPersistenceSurvivesCallerCancellation(t *testing.T) {
+	m, s, e, a := newRefreshPersistenceFixture(t)
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	e.during = cancel
+	if _, err := m.RefreshAuth(ctx, a.ID); err != nil {
+		t.Fatal(err)
+	}
+	if s.stored.Metadata["refresh_token"] != "synthetic-new-refresh" {
+		t.Fatal("completed rotation lost on caller cancellation")
+	}
+}
+func TestRefreshPersistenceConcurrentChange(t *testing.T) {
+	for _, change := range []string{"import", "disable", "remove", "reregister", "quota"} {
+		for _, failure := range []bool{false, true} {
+			name := change + map[bool]string{false: "_success", true: "_error"}[failure]
+			t.Run(name, func(t *testing.T) {
+				m, s, e, a := newRefreshPersistenceFixture(t)
+				if failure {
+					e.failure = &Error{HTTPStatus: 401, Code: "unauthorized", Message: "synthetic invalid"}
+				}
+				e.during = func() {
+					current, _ := m.GetByID(a.ID)
+					switch change {
+					case "import":
+						current.Metadata["access_token"] = "synthetic-imported"
+						current.Metadata["refresh_token"] = "synthetic-imported-refresh"
+					case "disable":
+						current.Disabled = true
+						current.Status = StatusDisabled
+					case "remove":
+						m.Remove(context.Background(), a.ID)
+						return
+					case "reregister":
+						m.Remove(context.Background(), a.ID)
+						_, err := m.Register(context.Background(), current)
+						if err != nil {
+							t.Fatal(err)
+						}
+						return
+					case "quota":
+						current.Quota = QuotaState{Exceeded: true, Reason: "credential_quota", NextRecoverAt: time.Now().Add(time.Hour)}
+						current.Unavailable = true
+						current.Status = StatusError
+						current.LastError = &Error{HTTPStatus: 429, Code: "quota"}
+					}
+					if _, err := m.Update(context.Background(), current); err != nil {
+						t.Fatal(err)
+					}
+				}
+				_, _ = m.RefreshAuth(context.Background(), a.ID)
+				current, exists := m.GetByID(a.ID)
+				if change == "remove" {
+					if exists {
+						t.Fatal("removed auth resurrected")
+					}
+					return
+				}
+				if !exists {
+					t.Fatal("auth lost")
+				}
+				switch change {
+				case "import":
+					if current.Metadata["access_token"] != "synthetic-imported" || s.stored.Metadata["refresh_token"] != "synthetic-imported-refresh" || hasUnauthorizedAuthFailure(current) {
+						t.Fatal("stale refresh overwrote import")
+					}
+				case "reregister":
+					if current.Metadata["access_token"] != "synthetic-old-access" || hasUnauthorizedAuthFailure(current) {
+						t.Fatal("stale refresh crossed registration epoch")
+					}
+				case "disable":
+					if !current.Disabled || current.Status != StatusDisabled {
+						t.Fatal("manual disable lost")
+					}
+					if !failure && s.stored.Metadata["refresh_token"] != "synthetic-new-refresh" {
+						t.Fatal("disabled auth lost rotated pair")
+					}
+				case "quota":
+					if !current.Quota.Exceeded || !current.Unavailable || current.LastError == nil || current.LastError.HTTPStatus != 429 {
+						t.Fatal("concurrent quota state lost")
+					}
+				}
+			})
+		}
+	}
+}
+func TestRefreshPersistenceUpdateReportsFailure(t *testing.T) {
+	m, s, _, a := newRefreshPersistenceFixture(t)
+	s.fail = true
+	if _, err := m.Update(context.Background(), a); err == nil {
