# 本文件列出号池管理服务的部署变量，不包含可直接使用的密钥。
ACCOUNT_POOL_DATABASE_URL=postgresql://account_pool:change-me@db:5432/account_pool
ACCOUNT_POOL_DB_PASSWORD=change-me
ACCOUNT_POOL_DATA_ROOT=/var/lib/litellm-account-pool/environments
ACCOUNT_POOL_MANAGER_TOKEN=replace-with-at-least-32-random-characters
ACCOUNT_POOL_SECRET_SEED=replace-with-a-separate-32-character-random-secret
ACCOUNT_POOL_MANAGER_CONTAINER=litellm-account-pool
ACCOUNT_POOL_GATEWAY_CONTAINER=litellm
ACCOUNT_POOL_DB_CONTAINER=litellm-account-pool-db
ACCOUNT_POOL_CONTROL_NETWORK=litellm-control
ACCOUNT_POOL_SSH_HOST=example.com
ACCOUNT_POOL_SSH_USER=litellm
ACCOUNT_POOL_CALLBACK_PORT=8091
ACCOUNT_POOL_CALLBACK_BIND_HOST=127.0.0.1
ACCOUNT_POOL_DOCKER_HOST=tcp://docker-socket-proxy:2375
ACCOUNT_POOL_DOCKER_COMMAND_TIMEOUT_SECONDS=60
ACCOUNT_POOL_CLI_PROXY_USER=65532:65532
ACCOUNT_POOL_CLI_PROXY_IMAGE=eceasy/cli-proxy-api:v7.2.146@sha256:238691ac26ce55e4d1c5219d72e3ad74838f81eda26359912eeb415e2820d163
