# Development Configs
LITELLM_MASTER_KEY = "sk-1234"
DATABASE_URL = "postgresql://llmproxy:dbpassword9090@db:5432/litellm"
STORE_MODEL_IN_DB = "True"
# LiteLLM 和 account-pool 必须使用同一个内部服务令牌。
ACCOUNT_POOL_INTERNAL_TOKEN = "replace-with-a-random-service-token"
# LiteLLM 签发短时 actor 信封，至少使用 32 字节且与内部令牌不同的随机密钥。
ACCOUNT_POOL_ACTOR_SECRET = "replace-with-another-random-secret-at-least-32-bytes"
