# 部署前把本文件复制为 .env 并填好所有值。所有密钥生成方式见 DEPLOY.md
# 镜像 tag：与推送时的 git commit 号一致，例如 47b84b0023
DEPLOY_TAG=

# LiteLLM 主库密码（自己起一个强密码，首次启动后固定）
LITELLM_DB_PASSWORD=

# 号池数据库密码（自己起一个强密码，首次启动后固定）
ACCOUNT_POOL_DB_PASSWORD=

# 号池 API 令牌：至少 32 位随机串，LiteLLM 与 Manager 之间共用
# 生成：openssl rand -hex 32
ACCOUNT_POOL_MANAGER_TOKEN=

# 号池凭据派生主密钥：至少 32 位随机串
# 一旦设定不可更换，否则所有已授权账号的凭据全部失效
# 生成：openssl rand -hex 32
ACCOUNT_POOL_SECRET_SEED=

# 服务器 SSH 信息：浏览器 OAuth 回调通过 SSH 隧道转发到 Manager
ACCOUNT_POOL_SSH_HOST=
ACCOUNT_POOL_SSH_USER=

# 浏览器 OAuth 回调端口（保持默认即可）
ACCOUNT_POOL_CALLBACK_PORT=8091

# Clash 代理网关（可选）：配置后号池页面出现代理网关面板
# Clash 配置需开启 external-controller 并预定义各端口的选择器（selector）
ACCOUNT_POOL_CLASH_CONTROLLER_URL=
# Clash external-controller 的访问密钥（未设置鉴权时留空）
ACCOUNT_POOL_CLASH_SECRET=
# 每个端口一个独立出口，逗号分隔，例如 7891,7892,7893
# 端口名必须是 clash-gateway-<端口>，如 clash-gateway-7891
ACCOUNT_POOL_CLASH_GATEWAY_PORTS=
