+  persisted_revision: z.string().regex(/^"sha256-[a-f0-9]{64}"$/),
+  active_revision: z
+    .string()
+    .regex(/^"sha256-[a-f0-9]{64}"$/)
+    .nullable(),
+  apply_supported: z.boolean(),
+  blocked_reason: z.enum(["non_policy_change", "unsupported_policy", "runtime_unavailable"]).nullable(),
