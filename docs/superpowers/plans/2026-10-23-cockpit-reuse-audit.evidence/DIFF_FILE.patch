+
+import httpx
+import pytest
+
+from litellm.proxy.management_endpoints.account_pool_cockpit_admin import (
+    CockpitAdminClient,
+    CockpitAdminConfig,
+)
+
+REVISION = '"sha256-' + "a" * 64 + '"'
+NEW_REVISION = '"sha256-' + "b" * 64 + '"'
+MANIFEST = {
