+"""位于 LiteLLM 内的 Cockpit 管理客户端过渡副本；不依赖旧 Manager，不负责选卡、重试或自动激活配置。"""
+
+from __future__ import annotations
+
+import ipaddress
+import re
+from dataclasses import dataclass, field
+from typing import Annotated, Final, Literal
+from urllib.parse import quote, urlsplit
+
+import httpx
+from pydantic import (
+    BaseModel,
+    ConfigDict,
+    Field,
+    JsonValue,
+    SecretStr,
+    TypeAdapter,
+    ValidationError,
+    field_validator,
+    model_validator,
+)
+from typing_extensions import Self
+
+
+class CockpitKeyCount(BaseModel):
+    model_config = ConfigDict(strict=True)
+
+    enabled: bool = False
+
+
+class CockpitCountManifest(BaseModel):
+    accounts: tuple[dict[str, JsonValue], ...] | None = None
+    apiKeys: tuple[CockpitKeyCount, ...] | None = None
+
+
+_ETAG: Final = r'^"sha256-[0-9a-f]{64}"$'
+_JSON: Final = TypeAdapter(dict[str, JsonValue])
+
+
+_HOST: Final = re.compile(
+    r"[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*\.?$"
+)
+
+
+def validate_http_origin(value: str) -> str:
+    try:
+        parsed: Final = urlsplit(value)
+        port: Final = parsed.port
+    except ValueError:
+        raise ValueError("URL must be a fixed HTTP(S) origin") from None
+    host: Final = parsed.hostname
+    valid_host: Final = host is not None and (
+        (":" in host and _valid_ip(host)) or (":" not in host and _HOST.fullmatch(host) is not None)
+    )
+    if (
+        parsed.scheme not in {"http", "https"}
+        or not valid_host
+        or parsed.username is not None
+        or parsed.password is not None
+        or parsed.path not in {"", "/"}
+        or parsed.query
+        or parsed.fragment
+        or "?" in value
+        or "#" in value
+        or "\\" in value
+        or parsed.netloc.endswith(":")
+        or (port is not None and not 1 <= port <= 65535)
+        or any(ord(char) <= 32 or ord(char) >= 127 for char in value)
+    ):
+        raise ValueError("URL must be a fixed HTTP(S) origin")
+    return value.rstrip("/")
+
+
+def _valid_ip(value: str) -> bool:
+    try:
+        ipaddress.ip_address(value)
+    except ValueError:
+        return False
+    return True
+
+
+def _valid_auth_name(name: str) -> bool:
+    return (
+        bool(name)
+        and name == name.strip()
+        and not name.startswith(".")
+        and name.lower().endswith(".json")
+        and not any(char in '/\\:*?"<>|' or ord(char) < 32 for char in name)
+    )
+
+
+valid_cockpit_auth_name: Final = _valid_auth_name
+
+
+class CockpitAdminConfig(BaseModel):
+    model_config = ConfigDict(frozen=True, hide_input_in_errors=True)
+
+    url: str = Field(repr=False)
+    token: SecretStr = Field(min_length=32)
+
+    @field_validator("url")
+    @classmethod
+    def validate_origin(cls, value: str) -> str:
+        return validate_http_origin(value)
+
+    @field_validator("token")
+    @classmethod
+    def validate_token(cls, value: SecretStr) -> SecretStr:
+        if any(ord(char) <= 32 or ord(char) >= 127 for char in value.get_secret_value()):
+            raise ValueError("Cockpit token must contain only printable non-space ASCII")
+        return value
+
+
+@dataclass(frozen=True, slots=True)
+class CockpitFailure:
+    category: Literal["transport", "http", "precondition", "invalid_input", "invalid_response"]
+    status_code: int | None = None
+    code: Literal["non_policy_change", "unsupported_policy"] | None = None
+
+
+class RuntimeSnapshot(BaseModel):
+    model_config = ConfigDict(frozen=True, strict=True)
+
+    persisted_revision: str = Field(alias="persistedRevision", pattern=_ETAG)
+    active_revision: Annotated[str, Field(pattern=_ETAG)] | None = Field(alias="activeRevision")
+    apply_supported: bool = Field(alias="applySupported")
+    blocked_reason: Literal["non_policy_change", "unsupported_policy", "runtime_unavailable"] | None = Field(
+        alias="blockedReason"
+    )
+
+    @model_validator(mode="after")
+    def consistent_activation(self) -> Self:
+        if self.apply_supported != (self.blocked_reason is None):
+            raise ValueError("Inconsistent runtime capability")
+        if (self.active_revision is None) != (self.blocked_reason == "runtime_unavailable"):
+            raise ValueError("Unknown runtime must remain unavailable")
+        return self
+
+
+@dataclass(frozen=True, slots=True)
+class ManifestSnapshot:
+    data: dict[str, JsonValue] = field(repr=False)
+    revision: str
+    account_count: int
+    enabled_key_count: int
+
+
+@dataclass(frozen=True, slots=True)
+class AdminReceipt:
+    status: Literal["persisted", "deleted", "restart_scheduled"]
+    revision: str | None = None
+
+
+class AuthFileMetadata(BaseModel):
+    model_config = ConfigDict(frozen=True, strict=True)
+
+    id: str = Field(repr=False)
+    etag: str = Field(pattern=_ETAG)
+    size: int = Field(ge=0)
+
+    @field_validator("id")
+    @classmethod
+    def validate_id(cls, value: str) -> str:
+        if not _valid_auth_name(value):
+            raise ValueError("Invalid Cockpit credential name")
+        return value
+
+
+class _AuthFiles(BaseModel):
+    files: tuple[AuthFileMetadata, ...]
+
+
+class CockpitAdminClient:
+    def __init__(self, config: CockpitAdminConfig, client: httpx.AsyncClient) -> None:
+        self._config = config
+        self._client = client
+
+    async def _request(
+        self,
+        method: str,
+        path: str,
+        expected: int | tuple[int, ...],
+        *,
+        content: bytes | None = None,
+        condition: tuple[str, str] | None = None,
+    ) -> httpx.Response | CockpitFailure:
+        try:
+            response: Final = await self._client.request(
+                method,
+                self._config.url + "/admin/v1/" + path,
+                headers={
+                    "Authorization": "Bearer " + self._config.token.get_secret_value(),
+                    "Content-Type": "application/json",
+                    **(dict((condition,)) if condition else {}),
+                },
+                content=content,
+                follow_redirects=False,
+            )
+        except httpx.HTTPError:
+            return CockpitFailure("transport")
+        if response.status_code not in ((expected,) if isinstance(expected, int) else expected):
+            return CockpitFailure(
+                "precondition" if response.status_code in {412, 428} else "http", response.status_code
+            )
+        return response
+
+    async def read_policy_runtime(self) -> RuntimeSnapshot | CockpitFailure:
+        return await self._policy_runtime()
+
+    async def apply_policy(self, revision: str) -> RuntimeSnapshot | CockpitFailure:
+        if not re.fullmatch(_ETAG, revision):
+            return CockpitFailure("invalid_input")
+        return await self._policy_runtime(revision)
+
+    async def _policy_runtime(self, revision: str | None = None) -> RuntimeSnapshot | CockpitFailure:
+        result: Final = await self._request(
+            "GET" if revision is None else "POST",
+            "policy-runtime" if revision is None else "policy-apply",
+            (200, 422),
+            condition=("If-Match", revision) if revision is not None else None,
+        )
+        if isinstance(result, CockpitFailure):
+            return result
+        try:
+            if result.status_code == 422:
+                error: Final = _JSON.validate_json(result.content).get("error")
+                code: Final = error.get("code") if isinstance(error, dict) else None
+                match code:
+                    case "non_policy_change" | "unsupported_policy":
+                        return CockpitFailure("http", 422, code)
+                    case _:
+                        return CockpitFailure("invalid_response", 422)
+            snapshot: Final = RuntimeSnapshot.model_validate_json(result.content)
+        except ValidationError:
+            return CockpitFailure("invalid_response", result.status_code)
+        if revision is not None and (
+            snapshot.persisted_revision != revision
+            or snapshot.active_revision != revision
+            or not snapshot.apply_supported
+        ):
+            return CockpitFailure("invalid_response", result.status_code)
+        return snapshot
+
+    async def read_manifest(self) -> ManifestSnapshot | CockpitFailure:
+        result: Final = await self._request("GET", "manifest", 200)
+        if isinstance(result, CockpitFailure):
+            return result
+        revision: Final = next((value for key, value in result.headers.items() if key.lower() == "etag"), "")
+        if not re.fullmatch(_ETAG, revision):
+            return CockpitFailure("invalid_response", result.status_code)
+        try:
+            data: Final = _JSON.validate_json(result.content)
+            counts: Final = CockpitCountManifest.model_validate(data)
+        except ValidationError:
+            return CockpitFailure("invalid_response", result.status_code)
+        return ManifestSnapshot(
+            data, revision, len(counts.accounts or ()), sum(k.enabled for k in counts.apiKeys or ())
+        )
+
+    async def write_manifest(self, data: dict[str, JsonValue], revision: str) -> AdminReceipt | CockpitFailure:
+        if not re.fullmatch(_ETAG, revision):
+            return CockpitFailure("invalid_input")
+        return await self._mutation(
+            "PUT", "manifest", "persisted", content=_JSON.dump_json(data), condition=("If-Match", revision)
+        )
+
+    async def list_auth_files(self) -> tuple[AuthFileMetadata, ...] | CockpitFailure:
+        result: Final = await self._request("GET", "auth-files", 200)
+        if isinstance(result, CockpitFailure):
+            return result
+        try:
+            return _AuthFiles.model_validate_json(result.content).files
+        except ValidationError:
+            return CockpitFailure("invalid_response", result.status_code)
+
+    async def put_auth_file(
+        self,
+        name: str,
+        content: bytes,
+        revision: str | None = None,
+    ) -> AdminReceipt | CockpitFailure:
+        if not _valid_auth_name(name) or (revision is not None and not re.fullmatch(_ETAG, revision)):
+            return CockpitFailure("invalid_input")
+        return await self._mutation(
+            "PUT",
+            "auth-files/" + quote(name, safe=""),
+            "persisted",
+            content=content,
+            condition=("If-Match", revision) if revision is not None else ("If-None-Match", "*"),
+        )
+
+    async def delete_auth_file(self, name: str, revision: str) -> AdminReceipt | CockpitFailure:
+        if not _valid_auth_name(name) or not re.fullmatch(_ETAG, revision):
+            return CockpitFailure("invalid_input")
+        return await self._mutation(
+            "DELETE", "auth-files/" + quote(name, safe=""), "deleted", condition=("If-Match", revision)
+        )
+
+    async def restart(self) -> AdminReceipt | CockpitFailure:
+        return await self._mutation("POST", "restart", "restart_scheduled")
+
+    async def _mutation(
+        self,
+        method: str,
+        path: str,
+        status: Literal["persisted", "deleted", "restart_scheduled"],
+        *,
+        content: bytes | None = None,
+        condition: tuple[str, str] | None = None,
+    ) -> AdminReceipt | CockpitFailure:
+        result: Final = await self._request(method, path, 202, content=content, condition=condition)
+        if isinstance(result, CockpitFailure):
+            return result
+        try:
+            body: Final = _JSON.validate_json(result.content)
+        except ValidationError:
+            return CockpitFailure("invalid_response", result.status_code)
+        revision: Final = result.headers["ETag"] if status == "persisted" and "ETag" in result.headers else None
+        if (
+            body.get("status") != status
+            or (status != "restart_scheduled" and body.get("restartRequired") is not True)
+            or (status == "persisted" and (revision is None or not re.fullmatch(_ETAG, revision)))
+        ):
+            return CockpitFailure("invalid_response", result.status_code)
+        return AdminReceipt(status, revision)
+
+
+class CockpitStatus(BaseModel):
+    model_config = ConfigDict(frozen=True, strict=True)
+
+    configured: bool
+    account_count: int = Field(default=0, ge=0)
+    enabled_key_count: int = Field(default=0, ge=0)
+    credential_count: int = Field(default=0, ge=0)
+    persisted_manifest_revision: Annotated[str, Field(pattern=_ETAG)] | None = None
+    runtime_activation: Literal["restart_required_or_unverified"] = "restart_required_or_unverified"
+
+
+async def cockpit_status(client: CockpitAdminClient | None) -> CockpitStatus | CockpitFailure:
+    if client is None:
+        return CockpitStatus(configured=False)
+    manifest: Final = await client.read_manifest()
+    if isinstance(manifest, CockpitFailure):
+        return manifest
+    files: Final = await client.list_auth_files()
+    if isinstance(files, CockpitFailure):
+        return files
+    return CockpitStatus(
+        configured=True,
+        account_count=manifest.account_count,
+        enabled_key_count=manifest.enabled_key_count,
+        credential_count=len(files),
+        persisted_manifest_revision=manifest.revision,
+    )
diff --git a/litellm/proxy/management_endpoints/account_pool_cockpit_credential_service.py b/litellm/proxy/management_endpoints/account_pool_cockpit_credential_service.py
new file mode 100644
index 0000000000..1dff449f02
--- /dev/null
+++ b/litellm/proxy/management_endpoints/account_pool_cockpit_credential_service.py
@@ -0,0 +1,125 @@
+from __future__ import annotations
+
+import hashlib
+import hmac
+import json
+import re
+from collections.abc import Callable
+from typing import Annotated, Final, Protocol
+
+from pydantic import Field, SecretStr, TypeAdapter, ValidationError
+
+from litellm.proxy.management_endpoints.account_pool_cockpit_receipt_contracts import (
+    CredentialBindings,
+    CredentialReceipt,
+    CredentialReceiptPayload,
+    CredentialReceiptRejection,
+    NativeCredentialBindings,
+    NativeCredentialReceipt,
+    NativeCredentialReceiptPayload,
+)
+
+Receipt = CredentialReceipt | NativeCredentialReceipt
+Bindings = CredentialBindings | NativeCredentialBindings
+_RECEIPT: Final[TypeAdapter[Receipt]] = TypeAdapter(Annotated[Receipt, Field(discriminator="status")])
+_HASH: Final = re.compile(r"^[0-9a-f]{64}$")
+_LIFETIME: Final = 300
+
+
+class CredentialObservationReader(Protocol):
+    """Trusted server observations only, never browser-supplied bindings."""
+
+    async def read(self, subject_hash: str) -> Bindings | CredentialReceiptRejection: ...
+
+
+def _canonical(payload: CredentialReceiptPayload | NativeCredentialReceiptPayload) -> bytes:
+    return json.dumps(payload.model_dump(mode="json"), sort_keys=True, separators=(",", ":")).encode()
+
+
+class CockpitCredentialReceiptService:
+    def __init__(
+        self,
+        observations: CredentialObservationReader | None,
+        signing_key: SecretStr,
+        clock: Callable[[], int],
+    ) -> None:
+        if len(signing_key.get_secret_value().encode()) < 32:
+            raise ValueError("Receipt signing key must contain at least 32 bytes")
+        self._observations: Final = observations
+        self._key: Final = signing_key
+        self._clock: Final = clock
+
+    def _now(self) -> int | None:
+        try:
+            value: Final = self._clock()
+        except Exception:  # noqa: BLE001  # A clock failure must not issue an unbounded receipt.
+            return None
+        return value if type(value) is int and value > 0 else None
+
+    def _signature(self, payload: CredentialReceiptPayload | NativeCredentialReceiptPayload) -> str:
+        return hmac.new(self._key.get_secret_value().encode(), _canonical(payload), hashlib.sha256).hexdigest()
+
+    async def issue(self, subject_hash: str) -> Receipt | CredentialReceiptRejection:
+        if _HASH.fullmatch(subject_hash) is None:
+            return CredentialReceiptRejection("invalid_subject")
+        issued_at: Final = self._now()
+        if issued_at is None:
+            return CredentialReceiptRejection("invalid_clock")
+        bindings: Final = await self._stable_observation(subject_hash)
+        if isinstance(bindings, CredentialReceiptRejection):
+            return bindings
+        finished_at: Final = self._now()
+        if finished_at is None or not issued_at <= finished_at < issued_at + _LIFETIME:
+            return CredentialReceiptRejection("receipt_time_invalid")
+        if isinstance(bindings, NativeCredentialBindings):
+            payload: Final = NativeCredentialReceiptPayload(
+                issued_at=issued_at, expires_at=issued_at + _LIFETIME, bindings=bindings
+            )
+            return NativeCredentialReceipt(payload=payload, signature=self._signature(payload))
+        legacy: Final = CredentialReceiptPayload(
+            issued_at=issued_at, expires_at=issued_at + _LIFETIME, bindings=bindings
+        )
+        return CredentialReceipt(payload=legacy, signature=self._signature(legacy))
+
+    async def revalidate(self, subject_hash: str, encoded: str) -> Receipt | CredentialReceiptRejection:
+        if _HASH.fullmatch(subject_hash) is None:
+            return CredentialReceiptRejection("invalid_subject")
+        if len(encoded) > 16384:
+            return CredentialReceiptRejection("invalid_receipt")
+        try:
+            receipt: Final = _RECEIPT.validate_json(encoded)
+        except ValidationError:
+            return CredentialReceiptRejection("invalid_receipt")
+        if (
+            not hmac.compare_digest(self._signature(receipt.payload), receipt.signature)
+            or receipt.payload.bindings.scope.subject_hash != subject_hash
+        ):
+            return CredentialReceiptRejection("invalid_receipt")
+        now: Final = self._now()
+        if now is None or not receipt.payload.issued_at <= now < receipt.payload.expires_at:
+            return CredentialReceiptRejection("receipt_time_invalid")
+        bindings: Final = await self._stable_observation(subject_hash)
+        if isinstance(bindings, CredentialReceiptRejection):
+            return bindings
+        if bindings != receipt.payload.bindings:
+            return CredentialReceiptRejection("stale_receipt")
+        finished_at: Final = self._now()
+        if finished_at is None or not receipt.payload.issued_at <= finished_at < receipt.payload.expires_at:
+            return CredentialReceiptRejection("receipt_time_invalid")
+        return receipt
+
+    async def _stable_observation(self, subject_hash: str) -> Bindings | CredentialReceiptRejection:
+        if self._observations is None:
+            return CredentialReceiptRejection("read_unavailable")
+        try:
+            first: Final = await self._observations.read(subject_hash)
+            if isinstance(first, CredentialReceiptRejection):
+                return first
+            if first.scope.subject_hash != subject_hash or first.scope.card_id != first.target_account_id:
+                return CredentialReceiptRejection("subject_unverified")
+            second: Final = await self._observations.read(subject_hash)
+            if isinstance(second, CredentialReceiptRejection):
+                return second
+            return first if first == second else CredentialReceiptRejection("state_changed")
+        except Exception:  # noqa: BLE001  # Observers can return errors containing credentials; expose only a fixed code.
+            return CredentialReceiptRejection("read_unavailable")
diff --git a/litellm/proxy/management_endpoints/account_pool_cockpit_failure.py b/litellm/proxy/management_endpoints/account_pool_cockpit_failure.py
new file mode 100644
index 0000000000..95c4a23371
--- /dev/null
+++ b/litellm/proxy/management_endpoints/account_pool_cockpit_failure.py
@@ -0,0 +1,31 @@
+"""分类 Cockpit 管理失败；各功能仍保留自己的公开错误码和状态映射。"""
+
+from __future__ import annotations
+
+from typing import Final
+
+from litellm.proxy.management_endpoints.account_pool_cockpit_admin import CockpitFailure
+
+
+def unavailable(failure: CockpitFailure) -> bool:
+    return failure.category == "transport" or failure.status_code == 503
+
+
+def precondition(failure: CockpitFailure) -> bool:
+    return failure.category == "precondition"
+
+
+def invalid_payload(failure: CockpitFailure) -> bool:
+    return failure.category == "invalid_response"
+
+
+def server_error(failure: CockpitFailure) -> bool:
+    return (failure.status_code or 0) >= 500
+
+
+def write_outcome_unknown(failure: CockpitFailure) -> bool:
+    return failure.category in {"transport", "invalid_response"} or server_error(failure)
+
+
+READ_FAILURE_STATUS: Final = 502
+UNAVAILABLE_STATUS: Final = 503
diff --git a/litellm/proxy/management_endpoints/account_pool_cockpit_native.py b/litellm/proxy/management_endpoints/account_pool_cockpit_native.py
new file mode 100644
index 0000000000..8cd15da54e
--- /dev/null
+++ b/litellm/proxy/management_endpoints/account_pool_cockpit_native.py
@@ -0,0 +1,212 @@
+from __future__ import annotations
+
+import os
+import time
+from collections.abc import Callable
+from functools import lru_cache, partial
+from typing import Final, Literal
+from uuid import UUID
+
+import httpx
+from pydantic import BaseModel, ConfigDict, Field, SecretStr, field_validator, model_validator
+from typing_extensions import Self
+
+from litellm.proxy.management_endpoints.account_pool_cockpit_admin import (
+    CockpitAdminClient,
+    CockpitAdminConfig,
+    CockpitFailure,
+    validate_http_origin,
+)
+from litellm.proxy.management_endpoints.account_pool_cockpit_credential_service import CockpitCredentialReceiptService
+from litellm.proxy.management_endpoints.account_pool_cockpit_native_observation import NativeCredentialObservation
+from litellm.proxy.management_endpoints.account_pool_cockpit_receipt_contracts import (
+    CredentialReceiptRejection,
+    NativeCredentialBindings,
+)
+from litellm.proxy.management_endpoints.account_pool_cockpit_runtime import (
+    CockpitPolicyRuntime,
+    RuntimeFailure,
+    read_cockpit_runtime,
+)
+from litellm.proxy.management_endpoints.account_pool_cockpit_scope_service import (
+    CockpitScopeManifest,
+    CockpitScopeService,
+    CockpitSubjectRouteState,
+    CockpitSubjectScopeView,
+    ScopeFailure,
+    SubjectReader,
+    subject_routing_token,
+)
+from litellm.proxy.management_endpoints.account_pool_cockpit_subject_reader import NativeTrustedSubjectReader
+
+
+def native_cockpit_enabled() -> bool:
+    backend: Final = os.getenv("ACCOUNT_POOL_BACKEND", "manager")
+    if backend not in ("manager", "cockpit"):
+        raise ValueError("ACCOUNT_POOL_BACKEND must be manager or cockpit")
+    return backend == "cockpit"
+
+
+class NativeCockpitError(Exception):
+    def __init__(self, status: int = 503, code: str = "unavailable") -> None:
+        self.status: Final = status
+        self.code: Final = code
+        super().__init__(code)
+
+
+class NativeCockpitConfig(BaseModel):
+    model_config = ConfigDict(frozen=True, hide_input_in_errors=True)
+
+    admin_url: str = Field(repr=False)
+    admin_token: SecretStr = Field(min_length=32)
+    data_url: str = Field(repr=False)
+    receipt_key: SecretStr = Field(min_length=32)
+    routing_seed: SecretStr = Field(min_length=32)
+
+    @field_validator("admin_url", "data_url")
+    @classmethod
+    def valid_url(cls, value: str) -> str:
+        return validate_http_origin(value)
+
+    @model_validator(mode="after")
+    def independent_secrets(self) -> Self:
+        CockpitAdminConfig(url=self.admin_url, token=self.admin_token)
+        if len({secret.get_secret_value() for secret in (self.admin_token, self.receipt_key, self.routing_seed)}) != 3:
+            raise ValueError("Admin token, receipt key and routing seed must be independent")
+        return self
+
+    @classmethod
+    def from_environment(cls) -> NativeCockpitConfig:
+        try:
+            return cls(
+                admin_url=os.environ["ACCOUNT_POOL_COCKPIT_ADMIN_URL"],
+                admin_token=SecretStr(os.environ["ACCOUNT_POOL_COCKPIT_ADMIN_TOKEN"]),
+                data_url=os.environ["ACCOUNT_POOL_COCKPIT_DATA_URL"],
+                receipt_key=SecretStr(os.environ["ACCOUNT_POOL_COCKPIT_RECEIPT_KEY"]),
+                routing_seed=SecretStr(os.environ["ACCOUNT_POOL_COCKPIT_ROUTING_SEED"]),
+            )
+        except (KeyError, ValueError):
+            raise NativeCockpitError(503, "native_configuration_invalid") from None
+
+
+class NativeCockpitAccountView(BaseModel):
+    account_id: UUID
+    credential_present: bool
+
+
+class NativeScopeStatus(BaseModel):
+    scope: CockpitSubjectScopeView
+    runtime: CockpitPolicyRuntime | None
+    runtime_state: Literal["active", "pending", "unavailable"]
+
+
+def _observation_matches(
+    observation: NativeCredentialBindings | CredentialReceiptRejection,
+    scope: CockpitSubjectScopeView | CockpitSubjectRouteState,
+) -> bool:
+    return (
+        isinstance(observation, NativeCredentialBindings)
+        and observation.manifest_revision == scope.persisted_manifest_revision
+        and observation.scope.subject_hash == scope.subject_hash
+        and scope.account_ids == (str(observation.target_account_id),)
+        and frozenset(observation.scope.models) == frozenset(scope.models)
+    )
+
+
+class NativeCockpitServices:
+    def __init__(
+        self,
+        config: NativeCockpitConfig,
+        *,
+        http: httpx.AsyncClient | None = None,
+        subjects: SubjectReader | None = None,
+        clock: Callable[[], int] = lambda: int(time.time()),
+    ) -> None:
+        self._owns_http: Final = http is None
+        self._http: Final = (
+            http if http is not None else httpx.AsyncClient(timeout=10, trust_env=False, follow_redirects=False)
+        )
+        self.target: Final = CockpitAdminClient(
+            CockpitAdminConfig(url=config.admin_url, token=config.admin_token), self._http
+        )
+        self.subjects: Final = subjects if subjects is not None else NativeTrustedSubjectReader()
+        self.observations: Final = NativeCredentialObservation(self.subjects, self.target)
+        self.receipts: Final = CockpitCredentialReceiptService(self.observations, config.receipt_key, clock)
+        self.scope: Final = CockpitScopeService(
+            self.receipts,
+            self.target,
+            partial(subject_routing_token, config.routing_seed),
+            config.data_url,
+            self.subjects,
+        )
+
+    async def close(self) -> None:
+        if self._owns_http:
+            await self._http.aclose()
+
+    async def accounts(self) -> tuple[NativeCockpitAccountView, ...]:
+        snapshot: Final = await self.target.read_manifest()
+        files: Final = await self.target.list_auth_files()
+        if isinstance(snapshot, CockpitFailure) or isinstance(files, CockpitFailure):
+            raise NativeCockpitError()
+        manifest: Final = CockpitScopeManifest.model_validate(snapshot.data)
+        return tuple(
+            NativeCockpitAccountView(
+                account_id=UUID(account.id),
+                credential_present=any(item.id == account.authId and item.size > 0 for item in files),
+            )
+            for account in manifest.accounts or ()
+        )
+
+    async def view(self, subject_hash: str) -> NativeScopeStatus:
+        scope: Final = await self.scope.read(subject_hash)
+        if isinstance(scope, ScopeFailure):
+            raise NativeCockpitError(scope.status, scope.code)
+        observation: Final = await self.observations.read(subject_hash) if scope.state == "active" else None
+        current: Final = (
+            scope.model_copy(update={"state": "blocked"})
+            if observation is not None and not _observation_matches(observation, scope)
+            else scope
+        )
+        runtime: Final = await read_cockpit_runtime(self.target)
+        if isinstance(runtime, RuntimeFailure):
+            return NativeScopeStatus(scope=current, runtime=None, runtime_state="unavailable")
+        live: Final = (
+            current.state == "active"
+            and runtime.active_revision == runtime.persisted_revision == scope.persisted_manifest_revision
+        )
+        return NativeScopeStatus(scope=current, runtime=runtime, runtime_state="active" if live else "pending")
+
+    async def route_state(self, subject_hash: str) -> CockpitSubjectRouteState:
+        state: Final = await self.scope.route_state(subject_hash)
+        if isinstance(state, ScopeFailure):
+            raise NativeCockpitError(state.status, state.code)
+        if state.state != "active":
+            return state
+        observation: Final = await self.observations.read(subject_hash)
+        runtime: Final = await read_cockpit_runtime(self.target)
+        if (
+            not _observation_matches(observation, state)
+            or isinstance(runtime, RuntimeFailure)
+            or runtime.active_revision != state.persisted_manifest_revision
+            or runtime.persisted_revision != state.persisted_manifest_revision
+        ):
+            return state.model_copy(update={"state": "blocked", "api_key": None, "origin": None})
+        return state
+
+
+@lru_cache(maxsize=1)
+def _configured_services() -> NativeCockpitServices:
+    return NativeCockpitServices(NativeCockpitConfig.from_environment())
+
+
+def native_cockpit_services() -> NativeCockpitServices:
+    if not native_cockpit_enabled():
+        raise NativeCockpitError(503, "native_backend_disabled")
+    return _configured_services()
+
+
+async def close_native_cockpit_services() -> None:
+    if _configured_services.cache_info().currsize:
+        await _configured_services().close()
+        _configured_services.cache_clear()
diff --git a/litellm/proxy/management_endpoints/account_pool_cockpit_native_api.py b/litellm/proxy/management_endpoints/account_pool_cockpit_native_api.py
new file mode 100644
index 0000000000..1b661071cf
--- /dev/null
+++ b/litellm/proxy/management_endpoints/account_pool_cockpit_native_api.py
@@ -0,0 +1,240 @@
+from __future__ import annotations
+
+from collections.abc import Callable, Coroutine
+from typing import Annotated, Final, Literal
+
+from fastapi import APIRouter, Depends, HTTPException, Request, Response
+from fastapi.exceptions import RequestValidationError
+from fastapi.responses import JSONResponse
+from fastapi.routing import APIRoute
+from pydantic import BaseModel, ConfigDict, Field
+
+from litellm.proxy._types import UserAPIKeyAuth
+from litellm.proxy.auth.user_api_key_auth import user_api_key_auth
+from litellm.proxy.common_utils.resource_ownership import is_proxy_admin
+from litellm.proxy.management_endpoints.account_pool_cockpit_native import (
+    NativeCockpitAccountView,
+    NativeCockpitError,
+    NativeCockpitServices,
+    NativeScopeStatus,
+    native_cockpit_enabled,
+    native_cockpit_services,
+)
+from litellm.proxy.management_endpoints.account_pool_cockpit_policy import (
+    CockpitPolicyUpdate,
+    CockpitPolicyView,
+    PolicyFailure,
+    read_cockpit_policy,
+    save_cockpit_policy,
+)
+from litellm.proxy.management_endpoints.account_pool_cockpit_receipt_contracts import (
+    CredentialReceiptRejection,
+    NativeCredentialReceipt,
+    ReceiptRejectionCode,
+)
+from litellm.proxy.management_endpoints.account_pool_cockpit_runtime import (
+    CockpitPolicyApply,
+    CockpitPolicyRuntime,
+    RuntimeFailure,
+    apply_cockpit_policy,
+    read_cockpit_runtime,
+)
+from litellm.proxy.management_endpoints.account_pool_cockpit_scope_service import (
+    CockpitScopeActivationRequest,
+    CockpitScopePublishRequest,
+    CockpitScopeRevokeRequest,
+    ScopeFailure,
+)
+
+
+class NativeSubjectRequest(BaseModel):
+    model_config = ConfigDict(frozen=True, extra="forbid", hide_input_in_errors=True)
+    key_hash: str = Field(pattern=r"^[0-9a-f]{64}$")
+
+
+class NativeReceiptRequest(NativeSubjectRequest):
+    receipt: str = Field(min_length=1, max_length=16384, repr=False)
+
+
+class NativeReceiptResponse(BaseModel):
+    key_hash: str
+    status: Literal["native_scope_verified", "rejected"]
+    receipt: str | None = Field(default=None, repr=False)
+    code: ReceiptRejectionCode | None = None
+    ready_to_migrate: Literal[False] = False
+
+
+class NativePreflightResponse(BaseModel):
+    key_hash: str
+    status: Literal["eligible", "blocked"]
+    code: ReceiptRejectionCode | None = None
+    revision: str | None = None
+    models: tuple[str, ...] = ()
+
+
+class NativeBackendResponse(BaseModel):
+    backend: Literal["manager", "cockpit"]
+
+
+class _NativeRoute(APIRoute):
+    def get_route_handler(self) -> Callable[[Request], Coroutine[object, object, Response]]:
+        original: Final = super().get_route_handler()
+
+        async def handle(request: Request) -> Response:
+            try:
+                response: Final = await original(request)
+            except RequestValidationError:
+                return JSONResponse(
+                    {"detail": "invalid_native_request"}, status_code=422, headers={"Cache-Control": "no-store"}
+                )
+            except NativeCockpitError as error:
+                return JSONResponse(
+                    {"detail": error.code}, status_code=error.status, headers={"Cache-Control": "no-store"}
+                )
+            except HTTPException as error:
+                return JSONResponse(
+                    {"detail": "native_access_denied"},
+                    status_code=error.status_code,
+                    headers={"Cache-Control": "no-store"},
+                )
+            except Exception:  # noqa: BLE001  # Never return credential-bearing driver or transport errors to the browser.
+                return JSONResponse({"detail": "unavailable"}, status_code=503, headers={"Cache-Control": "no-store"})
+            response.headers["Cache-Control"] = "no-store"
+            return response
+
+        return handle
+
+
+def authorize(user: Annotated[UserAPIKeyAuth, Depends(user_api_key_auth)]) -> None:
+    if not is_proxy_admin(user):
+        raise HTTPException(403, "Proxy admin required")
+
+
+class _NativeHandlers:
+    def __init__(self, provider: Callable[[], NativeCockpitServices]) -> None:
+        self._provider: Final = provider
+
+    async def configuration(self) -> NativeBackendResponse:
+        return NativeBackendResponse(backend="cockpit" if native_cockpit_enabled() else "manager")
+
+    async def accounts(self) -> tuple[NativeCockpitAccountView, ...]:
+        return await self._provider().accounts()
+
+    async def preflight(self, request: NativeSubjectRequest) -> NativePreflightResponse:
+        observed: Final = await self._provider().observations.read(request.key_hash)
+        if isinstance(observed, CredentialReceiptRejection):
+            return NativePreflightResponse(key_hash=request.key_hash, status="blocked", code=observed.code)
+        return NativePreflightResponse(
+            key_hash=request.key_hash,
+            status="eligible",
+            revision=observed.manifest_revision,
+            models=observed.scope.models,
+        )
+
+    def receipt_response(
+        self, key_hash: str, receipt: NativeCredentialReceipt | CredentialReceiptRejection
+    ) -> NativeReceiptResponse:
+        if isinstance(receipt, CredentialReceiptRejection):
+            return NativeReceiptResponse(key_hash=key_hash, status="rejected", code=receipt.code)
+        return NativeReceiptResponse(
+            key_hash=key_hash, status="native_scope_verified", receipt=receipt.model_dump_json()
+        )
+
+    async def issue(self, request: NativeSubjectRequest) -> NativeReceiptResponse:
+        receipt: Final = await self._provider().receipts.issue(request.key_hash)
+        return self.receipt_response(
+            request.key_hash,
+            receipt
+            if isinstance(receipt, (NativeCredentialReceipt, CredentialReceiptRejection))
+            else CredentialReceiptRejection("invalid_receipt"),
+        )
+
+    async def revalidate(self, request: NativeReceiptRequest) -> NativeReceiptResponse:
+        receipt: Final = await self._provider().receipts.revalidate(request.key_hash, request.receipt)
+        return self.receipt_response(
+            request.key_hash,
+            receipt
+            if isinstance(receipt, (NativeCredentialReceipt, CredentialReceiptRejection))
+            else CredentialReceiptRejection("invalid_receipt"),
+        )
+
+    async def view(self, subject_hash: Annotated[str, Field(pattern=r"^[0-9a-f]{64}$")]) -> NativeScopeStatus:
+        return await self._provider().view(subject_hash)
+
+    async def publish(self, request: CockpitScopePublishRequest) -> NativeScopeStatus:
+        services: Final = self._provider()
+        result: Final = await services.scope.publish(request)
+        if isinstance(result, ScopeFailure):
+            raise NativeCockpitError(result.status, result.code)
+        return await services.view(request.subject_hash)
+
+    async def revoke(self, request: CockpitScopeRevokeRequest) -> NativeScopeStatus:
+        services: Final = self._provider()
+        result: Final = await services.scope.revoke(request)
+        if isinstance(result, ScopeFailure):
+            raise NativeCockpitError(result.status, result.code)
+        return await services.view(request.subject_hash)
+
+    async def activate(self, request: CockpitScopeActivationRequest) -> NativeScopeStatus:
+        services: Final = self._provider()
+        result: Final = await services.scope.activate(request)
+        if isinstance(result, ScopeFailure):
+            raise NativeCockpitError(result.status, result.code)
+        return await services.view(request.subject_hash)
+
+    async def deactivate(self, request: CockpitScopeActivationRequest) -> NativeScopeStatus:
+        services: Final = self._provider()
+        result: Final = await services.scope.deactivate(request)
+        if isinstance(result, ScopeFailure):
+            raise NativeCockpitError(result.status, result.code)
+        return await services.view(request.subject_hash)
+
+    async def policy(self) -> CockpitPolicyView:
+        result: Final = await read_cockpit_policy(self._provider().target)
+        if isinstance(result, PolicyFailure):
+            raise NativeCockpitError(result.status, result.code)
+        return result
+
+    async def save_policy(self, request: CockpitPolicyUpdate) -> CockpitPolicyView:
+        result: Final = await save_cockpit_policy(self._provider().target, request)
+        if isinstance(result, PolicyFailure):
+            raise NativeCockpitError(result.status, result.code)
+        return result
+
+    async def runtime(self) -> CockpitPolicyRuntime:
+        result: Final = await read_cockpit_runtime(self._provider().target)
+        if isinstance(result, RuntimeFailure):
+            raise NativeCockpitError(result.status, result.code)
+        return result
+
+    async def apply_policy(self, request: CockpitPolicyApply) -> CockpitPolicyRuntime:
+        result: Final = await apply_cockpit_policy(self._provider().target, request)
+        if isinstance(result, RuntimeFailure):
+            raise NativeCockpitError(result.status, result.code)
+        return result
+
+
+def create_native_cockpit_router(provider: Callable[[], NativeCockpitServices] = native_cockpit_services) -> APIRouter:
+    handlers: Final = _NativeHandlers(provider)
+    router: Final = APIRouter(
+        prefix="/account_pool/cockpit/native",
+        tags=["Account Pool"],
+        route_class=_NativeRoute,
+        dependencies=[Depends(authorize)],
+    )
+
+    router.add_api_route("/policy/runtime", handlers.runtime, methods=["GET"])
+    router.add_api_route("/policy/apply", handlers.apply_policy, methods=["POST"])
+    router.add_api_route("/configuration", handlers.configuration, methods=["GET"])
+    router.add_api_route("/accounts", handlers.accounts, methods=["GET"])
+    router.add_api_route("/preflight", handlers.preflight, methods=["POST"])
+    router.add_api_route("/credential-receipts", handlers.issue, methods=["POST"])
+    router.add_api_route("/credential-receipts/revalidate", handlers.revalidate, methods=["POST"])
+    router.add_api_route("/scope/{subject_hash}", handlers.view, methods=["GET"])
+    router.add_api_route("/scope", handlers.publish, methods=["POST"])
+    router.add_api_route("/scope", handlers.revoke, methods=["DELETE"])
+    router.add_api_route("/scope/activate", handlers.activate, methods=["POST"])
+    router.add_api_route("/scope/deactivate", handlers.deactivate, methods=["POST"])
+    router.add_api_route("/policy", handlers.policy, methods=["GET"])
+    router.add_api_route("/policy", handlers.save_policy, methods=["PUT"])
+    return router
diff --git a/litellm/proxy/management_endpoints/account_pool_cockpit_native_observation.py b/litellm/proxy/management_endpoints/account_pool_cockpit_native_observation.py
new file mode 100644
index 0000000000..11daf899a6
--- /dev/null
+++ b/litellm/proxy/management_endpoints/account_pool_cockpit_native_observation.py
@@ -0,0 +1,100 @@
+from __future__ import annotations
+
+from typing import Final
+
+from pydantic import JsonValue
+
+from litellm.proxy.management_endpoints.account_pool_cockpit_admin import (
+    CockpitAdminClient,
+    CockpitFailure,
+    valid_cockpit_auth_name,
+)
+from litellm.proxy.management_endpoints.account_pool_cockpit_receipt_contracts import (
+    CredentialReceiptRejection,
+    NativeCredentialBindings,
+)
+from litellm.proxy.management_endpoints.account_pool_cockpit_scope_service import (
+    CockpitScopeManifest,
+    SubjectReader,
+    scope_models_visible,
+)
+
+
+def _alias(name: str) -> str:
+    return name.strip().casefold().removesuffix(".json")
+
+
+def _canonical_fields(data: dict[str, JsonValue], fields: tuple[str, ...]) -> bool:
+    return not any(key.casefold() == field.casefold() and key != field for key in data for field in fields)
+
+
+def _canonical(data: dict[str, JsonValue]) -> bool:
+    fields: Final = ("accounts", "apiKeys", "modelIds", "excludedModels", "accountModelRules", "modelAliases")
+    if not _canonical_fields(data, fields):
+        return False
+    sections: Final = (
+        ("accounts", ("id", "authId", "authKind", "accessTokenOnly", "upstreamApiKey")),
+        ("apiKeys", ("id", "label", "key", "enabled", "accountIds", "allowedModels")),
+        ("accountModelRules", ("accountId", "excludedModels")),
+        ("modelAliases", ("sourceModel", "alias")),
+    )
+    return all(
+        _canonical_fields(item, names)
+        for section, names in sections
+        for entries in (data.get(section),)
+        if isinstance(entries, list)
+        for item in entries
+        if isinstance(item, dict)
+    )
+
+
+class NativeCredentialObservation:
+    def __init__(self, subjects: SubjectReader, target: CockpitAdminClient) -> None:
+        self._subjects: Final = subjects
+        self._target: Final = target
+
+    async def read(self, subject_hash: str) -> NativeCredentialBindings | CredentialReceiptRejection:
+        scope: Final = await self._subjects.read(subject_hash)
+        if scope is None or scope.subject_hash != subject_hash:
+            return CredentialReceiptRejection("subject_unverified")
+        snapshot: Final = await self._target.read_manifest()
+        if isinstance(snapshot, CockpitFailure):
+            return CredentialReceiptRejection("read_unavailable")
+        if not _canonical(snapshot.data):
+            return CredentialReceiptRejection("target_auth_unsupported")
+        manifest: Final = CockpitScopeManifest.model_validate(snapshot.data)
+        accounts: Final = manifest.accounts or ()
+        matches: Final = tuple(account for account in accounts if account.id.strip().lower() == str(scope.card_id))
+        if not matches:
+            return CredentialReceiptRejection("target_account_missing")
+        if len(matches) != 1:
+            return CredentialReceiptRejection("target_account_collision")
+        account: Final = matches[0]
+        if (
+            account.id != str(scope.card_id)
+            or not valid_cockpit_auth_name(account.authId)
+            or account.authKind not in ("", "oauth")
+            or account.accessTokenOnly
+            or account.upstreamApiKey.strip()
+        ):
+            return CredentialReceiptRejection("target_auth_unsupported")
+        if sum(_alias(item.authId) == _alias(account.authId) for item in accounts) != 1:
+            return CredentialReceiptRejection("target_credential_collision")
+        if not scope_models_visible(manifest, scope):
+            return CredentialReceiptRejection("subject_unverified")
+        files: Final = await self._target.list_auth_files()
+        if isinstance(files, CockpitFailure):
+            return CredentialReceiptRejection("read_unavailable")
+        if sum(_alias(item.id) == _alias(account.authId) for item in files) > 1:
+            return CredentialReceiptRejection("target_credential_collision")
+        matched: Final = tuple(item for item in files if item.id == account.authId and item.size > 0)
+        if len(matched) != 1:
+            return CredentialReceiptRejection("target_credential_missing")
+        return NativeCredentialBindings(
+            scope=scope,
+            target_account_id=scope.card_id,
+            target_auth_id=account.authId,
+            target_file_revision=matched[0].etag,
+            target_file_size=matched[0].size,
+            manifest_revision=snapshot.revision,
+        )
diff --git a/litellm/proxy/management_endpoints/account_pool_cockpit_policy.py b/litellm/proxy/management_endpoints/account_pool_cockpit_policy.py
new file mode 100644
index 0000000000..33fb0512ea
--- /dev/null
+++ b/litellm/proxy/management_endpoints/account_pool_cockpit_policy.py
@@ -0,0 +1,238 @@
+"""条件写入 Cockpit 原生 Codex 池策略；不迁移授权、凭据或自动重启。"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Final, Literal
+
+from pydantic import BaseModel, ConfigDict, Field, JsonValue, ValidationError, model_validator
+from typing_extensions import Self
+
+from litellm.proxy.management_endpoints.account_pool_cockpit_admin import (
+    CockpitAdminClient,
+    CockpitFailure,
+    ManifestSnapshot,
+)
+from litellm.proxy.management_endpoints.account_pool_cockpit_failure import (
+    precondition,
+    unavailable,
+    write_outcome_unknown,
+)
+
+
+class CockpitAccount(BaseModel):
+    model_config = ConfigDict(strict=True)
+
+    id: str
+    authId: str = ""
+    authKind: str = ""
+    accessTokenOnly: bool = False
+    upstreamApiKey: str = Field(default="", repr=False)
+
+
+class CockpitPolicyAccount(CockpitAccount):
+    model_config = ConfigDict(strict=True)
+
+    id: str = Field(min_length=1, max_length=256, pattern=r"^[A-Za-z0-9_-]+$")
+
+
+class CockpitPolicyManifest(BaseModel):
+    routingStrategy: str = "auto"
+    accounts: tuple[CockpitPolicyAccount, ...] | None = None
+    customRoutingRules: tuple[dict[str, JsonValue], ...] | None = None
+
+
+CockpitStrategy = Literal[
+    "auto",
+    "random",
+    "quota_high_first",
+    "quota_low_first",
+    "plan_high_first",
+    "plan_low_first",
+    "expiry_soon_first",
+    "custom",
+]
+STRATEGIES: Final[tuple[CockpitStrategy, ...]] = (
+    "auto",
+    "random",
+    "quota_high_first",
+    "quota_low_first",
+    "plan_high_first",
+    "plan_low_first",
+    "expiry_soon_first",
+    "custom",
+)
+
+
+class CockpitRoutingRule(BaseModel):
+    model_config = ConfigDict(frozen=True, extra="forbid")
+
+    account_id: str = Field(min_length=1, max_length=256, pattern=r"^[A-Za-z0-9_-]+$")
+    priority: int = Field(default=0, ge=-10000, le=10000, strict=True)
+    weight: int = Field(default=1, ge=1, le=10000, strict=True)
+    is_backup: bool = Field(default=False, strict=True)
+    is_preferred: bool = Field(default=False, strict=True)
+
+    @model_validator(mode="after")
+    def check_role(self) -> Self:
+        if self.is_backup and self.is_preferred:
+            raise ValueError("An account cannot be both backup and preferred")
+        return self
+
+
+class CockpitPolicyUpdate(BaseModel):
+    model_config = ConfigDict(frozen=True, extra="forbid")
+
+    revision: str = Field(pattern=r'^"sha256-[0-9a-f]{64}"$')
+    routing_strategy: CockpitStrategy
+    custom_rules: tuple[CockpitRoutingRule, ...] = Field(max_length=256)
+
+
+class CockpitPolicyView(BaseModel):
+    model_config = ConfigDict(frozen=True)
+
+    revision: str = Field(pattern=r'^"sha256-[0-9a-f]{64}"$')
+    routing_strategy: str
+    custom_rules: tuple[CockpitRoutingRule, ...]
+    account_ids: tuple[str, ...]
+    editable: bool
+    blocked_reason: Literal["unsupported_account_or_rule", "unsupported_strategy"] | None
+    scope: Literal["codex_pool_global"] = "codex_pool_global"
+    runtime_activation: Literal["restart_required_or_unverified"] = "restart_required_or_unverified"
+    supported_strategies: tuple[CockpitStrategy, ...] = STRATEGIES
+    unsupported_fields: tuple[str, ...] = (
+        "account_enabled",
+        "candidate_scope",
+        "fallback_enabled",
+        "max_attempts",
+        "cooldown",
+        "session_affinity",
+    )
+
+
+@dataclass(frozen=True, slots=True)
+class PolicyFailure:
+    status: int
+    code: Literal[
+        "unavailable",
+        "invalid_response",
+        "unsupported_account_or_rule",
+        "unsupported_strategy",
+        "revision_conflict",
+        "invalid_rule_accounts",
+        "write_outcome_unknown",
+        "write_rejected",
+    ]
+
+
+def _rule(raw: dict[str, JsonValue]) -> CockpitRoutingRule:
+    return CockpitRoutingRule.model_validate(
+        {
+            "account_id": raw.get("accountId"),
+            "priority": raw.get("priority", 0),
+            "weight": raw.get("weight", 1),
+            "is_backup": raw.get("isBackup", False),
+            "is_preferred": raw.get("isPreferred", False),
+        }
+    )
+
+
+def _view(snapshot: ManifestSnapshot) -> CockpitPolicyView | PolicyFailure:
+    try:
+        manifest: Final = CockpitPolicyManifest.model_validate(snapshot.data)
+        rules: Final = tuple(_rule(raw) for raw in manifest.customRoutingRules or ())
+    except ValidationError:
+        return PolicyFailure(502, "invalid_response")
+    ids: Final = tuple(account.id for account in manifest.accounts or ())
+    rule_ids: Final = tuple(rule.account_id for rule in rules)
+    # 全局排序只作用于 Codex 池；不声称 providerGateway 或其他凭据路径具备同等语义。
+    account_blocked: Final = (
+        not ids
+        or len(ids) > 256
+        or len(set(ids)) != len(ids)
+        or len(set(rule_ids)) != len(rule_ids)
+        or any(rule_id not in ids for rule_id in rule_ids)
+        or any(account.authKind not in {"", "oauth"} for account in manifest.accounts or ())
+    )
+    reason: Final = (
+        "unsupported_account_or_rule"
+        if account_blocked
+        else "unsupported_strategy"
+        if manifest.routingStrategy not in STRATEGIES
+        else None
+    )
+    return CockpitPolicyView(
+        revision=snapshot.revision,
+        routing_strategy=manifest.routingStrategy,
+        custom_rules=rules,
+        account_ids=ids,
+        editable=reason is None,
+        blocked_reason=reason,
+    )
+
+
+async def read_cockpit_policy(client: CockpitAdminClient | None) -> CockpitPolicyView | PolicyFailure:
+    if client is None:
+        return PolicyFailure(503, "unavailable")
+    snapshot: Final = await client.read_manifest()
+    if isinstance(snapshot, CockpitFailure):
+        return PolicyFailure(503 if unavailable(snapshot) else 502, "unavailable")
+    return _view(snapshot)
+
+
+async def save_cockpit_policy(
+    client: CockpitAdminClient | None,
+    request: CockpitPolicyUpdate,
+) -> CockpitPolicyView | PolicyFailure:
+    if client is None:
+        return PolicyFailure(503, "unavailable")
+    snapshot: Final = await client.read_manifest()
+    if isinstance(snapshot, CockpitFailure):
+        return PolicyFailure(503, "unavailable")
+    if snapshot.revision != request.revision:
+        return PolicyFailure(409, "revision_conflict")
+    view: Final = _view(snapshot)
+    if isinstance(view, PolicyFailure):
+        return view
+    if view.blocked_reason is not None:
+        return PolicyFailure(422, view.blocked_reason)
+    ids: Final = tuple(rule.account_id for rule in request.custom_rules)
+    if len(ids) != len(set(ids)) or any(account_id not in view.account_ids for account_id in ids):
+        return PolicyFailure(422, "invalid_rule_accounts")
+    manifest: Final = CockpitPolicyManifest.model_validate(snapshot.data)
+    old_rules: Final = {
+        raw.get("accountId"): raw for raw in manifest.customRoutingRules or () if isinstance(raw.get("accountId"), str)
+    }
+    data: Final[dict[str, JsonValue]] = {
+        **snapshot.data,
+        "routingStrategy": request.routing_strategy,
+        "customRoutingRules": [
+            {
+                **old_rules.get(rule.account_id, {}),
+                "accountId": rule.account_id,
+                "priority": rule.priority,
+                "weight": rule.weight,
+                "isBackup": rule.is_backup,
+                "isPreferred": rule.is_preferred,
+            }
+            for rule in request.custom_rules
+        ],
+    }
+    # 单次 CAS 更新，不写第二份策略或凭据。响应丢失时不能盲目补偿覆盖并发管理员。
+    receipt: Final = await client.write_manifest(data, request.revision)
+    if isinstance(receipt, CockpitFailure):
+        if precondition(receipt):
+            return PolicyFailure(409, "revision_conflict")
+        if write_outcome_unknown(receipt):
+            return PolicyFailure(503, "write_outcome_unknown")
+        return PolicyFailure(502, "write_rejected")
+    if receipt.revision is None:
+        return PolicyFailure(503, "write_outcome_unknown")
+    return CockpitPolicyView(
+        revision=receipt.revision,
+        routing_strategy=request.routing_strategy,
+        custom_rules=request.custom_rules,
+        account_ids=view.account_ids,
+        editable=True,
+        blocked_reason=None,
+    )
diff --git a/litellm/proxy/management_endpoints/account_pool_cockpit_receipt_contracts.py b/litellm/proxy/management_endpoints/account_pool_cockpit_receipt_contracts.py
