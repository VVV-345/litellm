+def _client(handler: Callable[[httpx.Request], httpx.Response]) -> AccountPoolManagerClient:
+    return AccountPoolManagerClient(
+        "http://manager.test", TOKEN, client=httpx.AsyncClient(transport=httpx.MockTransport(handler))
+    )
